<UserControl x:Class="Lahanku.Controls.Sidebar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="NavItem" TargetType="Border">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F1F5F9" />
                </Trigger>
                <Trigger Property="Tag" Value="active">
                    <Setter Property="Background" Value="#E8F5E9" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NavIcon" TargetType="Path">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,14,0" />
            <Setter Property="Fill" Value="{StaticResource TextSecondaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Border}}" Value="active">
                    <Setter Property="Fill" Value="{StaticResource PrimaryGreenBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NavText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Border}}" Value="active">
                    <Setter Property="Foreground" Value="{StaticResource PrimaryGreenBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <!-- one sidebar for every page; commands live on MainViewModel (the window's DataContext) -->
    <Border Background="{StaticResource SidebarBackgroundBrush}"
            BorderBrush="#E2E8F0"
            BorderThickness="0,0,1,0"
            Padding="24,28"
            DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,36">
                <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource AccentEmeraldBrush}" Margin="0,0,12,0">
                    <Path Data="{StaticResource LeafPath}" Fill="#FFFFFF" Width="18" Height="18" Stretch="Uniform"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="LahanKu" Foreground="{StaticResource TextPrimaryBrush}" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Grid.Row="1">
                <Border x:Name="NavSummary" Style="{StaticResource NavItem}">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{Binding GoToDashboardCommand}" />
                    </Border.InputBindings>
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource HomePath}" Style="{StaticResource NavIcon}" />
                        <TextBlock Text="Ringkasan" Style="{StaticResource NavText}" />
                    </StackPanel>
                </Border>

                <Border x:Name="NavImpact" Style="{StaticResource NavItem}">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{Binding GoToImpactCommand}" />
                    </Border.InputBindings>
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource ChartLinePath}" Style="{StaticResource NavIcon}" />
                        <TextBlock Text="Dampak" Style="{StaticResource NavText}" />
                    </StackPanel>
                </Border>

                <Border x:Name="NavProfile" Style="{StaticResource NavItem}">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{Binding GoToProfileCommand}" />
                    </Border.InputBindings>
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource UserPath}" Style="{StaticResource NavIcon}" />
                        <TextBlock Text="Profil" Style="{StaticResource NavText}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- user card + logout -->
            <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="14" Padding="14,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="34" Height="34" CornerRadius="17" Background="{StaticResource MintBgBrush}" Margin="0,0,10,0">
                        <Path Data="{StaticResource UserPath}" Fill="{StaticResource MintTextBrush}" Width="14" Height="14" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentUserName}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding CurrentUserUsername}" Foreground="{StaticResource TextMutedBrush}" FontSize="10.5" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <Button Grid.Column="2" Command="{Binding LogoutCommand}" ToolTip="Keluar Akun" Style="{StaticResource IconButtonStyle}">
                        <Path Data="{StaticResource ArrowLeftPath}" Fill="{StaticResource TextSecondaryBrush}" Width="14" Height="14" Stretch="Uniform" />
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
