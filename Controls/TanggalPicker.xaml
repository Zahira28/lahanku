<UserControl x:Class="Lahanku.Controls.TanggalPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!-- chip pilihan cepat (Hari ini / Kemarin / 2 hari lalu) -->
        <Style x:Key="ChipStyle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="11,6">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#A7F3D0" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#ECFDF5" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="#A7F3D0" />
                                <Setter Property="Foreground" Value="#047857" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- tombol ‹ › ganti bulan -->
        <Style x:Key="NavStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F1F5F9" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#CBD5E1" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- satu kotak tanggal -->
        <Style x:Key="HariStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="1" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1.5" CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F0FDF4" />
                            </Trigger>
                            <DataTrigger Binding="{Binding BulanLain}" Value="True">
                                <Setter Property="Foreground" Value="#CBD5E1" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HariIni}" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#10B981" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Terpilih}" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#059669" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="#059669" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Nonaktif}" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="#CBD5E1" />
                                <Setter Property="IsEnabled" Value="False" />
                                <Setter Property="Cursor" Value="No" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- kotak jam/menit -->
        <Style x:Key="WaktuBoxStyle" TargetType="TextBox">
            <Setter Property="Width" Value="28" />
            <Setter Property="MaxLength" Value="2" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <!-- pilihan cepat -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <ToggleButton x:Name="ChipHariIni" Tag="0" Content="Hari ini" Style="{StaticResource ChipStyle}" Click="Chip_Click" />
            <ToggleButton x:Name="ChipKemarin" Tag="1" Content="Kemarin" Style="{StaticResource ChipStyle}" Click="Chip_Click" />
            <ToggleButton x:Name="ChipLusa" Tag="2" Content="2 hari lalu" Style="{StaticResource ChipStyle}" Click="Chip_Click" />
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- kolom tanggal, klik buat buka kalender -->
            <Border x:Name="FieldTanggal"
                    Grid.Column="0"
                    Height="46"
                    Padding="16,0"
                    CornerRadius="23"
                    Background="{StaticResource InputBackgroundBrush}"
                    BorderThickness="1.2"
                    Cursor="Hand"
                    MouseLeftButtonUp="FieldTanggal_Click">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsOpen, ElementName=KalenderPopup}" Value="True">
                                <Setter Property="BorderBrush" Value="#10B981" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Path Data="{StaticResource CalendarPath}" Fill="{StaticResource TextSecondaryBrush}"
                          Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock x:Name="TanggalText" Grid.Column="1" FontSize="14" VerticalAlignment="Center"
                               Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                    <Path Grid.Column="2" Data="{StaticResource ChevronDownPath}" Fill="{StaticResource TextMutedBrush}"
                          Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- jam : menit -->
            <Border Grid.Column="2"
                    Height="46"
                    Padding="12,0"
                    CornerRadius="23"
                    Background="{StaticResource InputBackgroundBrush}"
                    BorderBrush="{StaticResource InputBorderBrush}"
                    BorderThickness="1.2">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBox x:Name="JamBox" Style="{StaticResource WaktuBoxStyle}" TextChanged="Waktu_TextChanged" ToolTip="Jam (00–23)" />
                    <TextBlock Text=":" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="2,0" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBox x:Name="MenitBox" Style="{StaticResource WaktuBoxStyle}" TextChanged="Waktu_TextChanged" ToolTip="Menit (00–59)" />
                </StackPanel>
            </Border>
        </Grid>

        <Popup x:Name="KalenderPopup"
               PlacementTarget="{Binding ElementName=FieldTanggal}"
               Placement="Bottom"
               VerticalOffset="6"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade">
            <Border Width="300"
                    Margin="0,0,12,12"
                    Padding="14"
                    Background="#FFFFFF"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="14"
                    Effect="{StaticResource CardShadow}">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Button x:Name="TombolMundur" HorizontalAlignment="Left" Style="{StaticResource NavStyle}" Click="Mundur_Click" ToolTip="Bulan sebelumnya">
                            <Path Data="M15.41,16.58L10.83,12L15.41,7.41L14,6L8,12L14,18L15.41,16.58Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="14" Height="14" Stretch="Uniform" />
                        </Button>
                        <TextBlock x:Name="JudulBulan" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <Button x:Name="TombolMaju" HorizontalAlignment="Right" Style="{StaticResource NavStyle}" Click="Maju_Click" ToolTip="Bulan berikutnya">
                            <Path Data="M8.59,16.58L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.58Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="14" Height="14" Stretch="Uniform" />
                        </Button>
                    </Grid>

                    <UniformGrid Columns="7" Margin="0,0,0,4">
                        <TextBlock Text="Sen" HorizontalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" />
                        <TextBlock Text="Sel" HorizontalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" />
                        <TextBlock Text="Rab" HorizontalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" />
                        <TextBlock Text="Kam" HorizontalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" />
                        <TextBlock Text="Jum" HorizontalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" />
                        <TextBlock Text="Sab" HorizontalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" />
                        <TextBlock Text="Min" HorizontalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" />
                    </UniformGrid>

                    <ItemsControl x:Name="DaftarHari">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="7" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Angka}" Tag="{Binding Tanggal}" Style="{StaticResource HariStyle}" Click="Hari_Click" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Popup>
    </StackPanel>
</UserControl>
