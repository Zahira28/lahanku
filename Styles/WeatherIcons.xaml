<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Vector weather icons, 48x48 canvas. Picked by key from WeatherService (sun, partly, cloudy, ...) -->

    <GeometryGroup x:Key="WeatherCloudGeometry" FillRule="Nonzero">
        <RectangleGeometry Rect="8,26,34,12" RadiusX="6" RadiusY="6" />
        <EllipseGeometry Center="16,28" RadiusX="8" RadiusY="8" />
        <EllipseGeometry Center="26,22" RadiusX="10" RadiusY="10" />
        <EllipseGeometry Center="35,28" RadiusX="7" RadiusY="7" />
    </GeometryGroup>

    <Geometry x:Key="WeatherSunRaysGeometry">M36,24 L41,24 M32.5,32.5 L36,36 M24,36 L24,41 M15.5,32.5 L12,36 M12,24 L7,24 M15.5,15.5 L12,12 M24,12 L24,7 M32.5,15.5 L36,12</Geometry>

    <SolidColorBrush x:Key="WeatherSunBrush" Color="#F59E0B" />
    <SolidColorBrush x:Key="WeatherCloudBrush" Color="#CBD5E1" />
    <SolidColorBrush x:Key="WeatherCloudDarkBrush" Color="#94A3B8" />
    <SolidColorBrush x:Key="WeatherStormCloudBrush" Color="#64748B" />
    <SolidColorBrush x:Key="WeatherRainBrush" Color="#3B82F6" />
    <SolidColorBrush x:Key="WeatherDrizzleBrush" Color="#60A5FA" />

    <DataTemplate x:Key="WeatherIcon.sun">
        <Viewbox>
            <Canvas Width="48" Height="48">
                <Path Data="{StaticResource WeatherSunRaysGeometry}" Stroke="{StaticResource WeatherSunBrush}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                <Ellipse Canvas.Left="16" Canvas.Top="16" Width="16" Height="16" Fill="{StaticResource WeatherSunBrush}" />
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="WeatherIcon.partly">
        <Viewbox>
            <Canvas Width="48" Height="48">
                <Canvas RenderTransform="0.7,0,0,0.7,0,0">
                    <Path Data="{StaticResource WeatherSunRaysGeometry}" Stroke="{StaticResource WeatherSunBrush}" StrokeThickness="3.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    <Ellipse Canvas.Left="16" Canvas.Top="16" Width="16" Height="16" Fill="{StaticResource WeatherSunBrush}" />
                </Canvas>
                <!-- white halo behind the cloud so it separates from the sun -->
                <Path Data="{StaticResource WeatherCloudGeometry}" Fill="#FFFFFF" Stroke="#FFFFFF" StrokeThickness="4" RenderTransform="0.9,0,0,0.9,7,9" />
                <Path Data="{StaticResource WeatherCloudGeometry}" Fill="{StaticResource WeatherCloudBrush}" RenderTransform="0.9,0,0,0.9,7,9" />
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="WeatherIcon.cloudy">
        <Viewbox>
            <Canvas Width="48" Height="48">
                <Path Data="{StaticResource WeatherCloudGeometry}" Fill="{StaticResource WeatherCloudBrush}" RenderTransform="0.8,0,0,0.8,10,0" />
                <Path Data="{StaticResource WeatherCloudGeometry}" Fill="#FFFFFF" Stroke="#FFFFFF" StrokeThickness="4" RenderTransform="1,0,0,1,-2,6" />
                <Path Data="{StaticResource WeatherCloudGeometry}" Fill="{StaticResource WeatherCloudDarkBrush}" RenderTransform="1,0,0,1,-2,6" />
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="WeatherIcon.rain">
        <Viewbox>
            <Canvas Width="48" Height="48">
                <Path Data="{StaticResource WeatherCloudGeometry}" Fill="{StaticResource WeatherCloudDarkBrush}" RenderTransform="1,0,0,1,0,-6" />
                <Path Data="M16,37 L13,44 M25,37 L22,44 M34,37 L31,44" Stroke="{StaticResource WeatherRainBrush}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="WeatherIcon.drizzle">
        <Viewbox>
            <Canvas Width="48" Height="48">
                <Path Data="{StaticResource WeatherCloudGeometry}" Fill="{StaticResource WeatherCloudBrush}" RenderTransform="1,0,0,1,0,-6" />
                <Ellipse Canvas.Left="13" Canvas.Top="37" Width="4.5" Height="4.5" Fill="{StaticResource WeatherDrizzleBrush}" />
                <Ellipse Canvas.Left="22" Canvas.Top="41" Width="4.5" Height="4.5" Fill="{StaticResource WeatherDrizzleBrush}" />
                <Ellipse Canvas.Left="31" Canvas.Top="37" Width="4.5" Height="4.5" Fill="{StaticResource WeatherDrizzleBrush}" />
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="WeatherIcon.storm">
        <Viewbox>
            <Canvas Width="48" Height="48">
                <Path Data="{StaticResource WeatherCloudGeometry}" Fill="{StaticResource WeatherStormCloudBrush}" RenderTransform="1,0,0,1,0,-6" />
                <Polygon Points="28,24 16,40 24,40 20,48 35,31 27,31 31,24" Fill="{StaticResource WeatherSunBrush}" Stroke="#FFFFFF" StrokeThickness="2" StrokeLineJoin="Round" />
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="WeatherIcon.fog">
        <Viewbox>
            <Canvas Width="48" Height="48">
                <Path Data="{StaticResource WeatherCloudGeometry}" Fill="{StaticResource WeatherCloudBrush}" RenderTransform="1,0,0,1,0,-7" />
                <Path Data="M10,37 L36,37 M14,43 L40,43" Stroke="{StaticResource WeatherCloudDarkBrush}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="WeatherIcon.offline">
        <Viewbox>
            <Canvas Width="48" Height="48">
                <Path Data="{StaticResource WeatherCloudGeometry}" Fill="#E2E8F0" />
                <Path Data="M11,9 L39,41" Stroke="{StaticResource WeatherCloudDarkBrush}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <!-- watering decision icons: sun + drop (extra), drop (normal) -->
    <DataTemplate x:Key="WeatherIcon.sundrop">
        <Viewbox>
            <Canvas Width="48" Height="48">
                <Canvas RenderTransform="0.75,0,0,0.75,-2,-2">
                    <Path Data="{StaticResource WeatherSunRaysGeometry}" Stroke="{StaticResource WeatherSunBrush}" StrokeThickness="3.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    <Ellipse Canvas.Left="16" Canvas.Top="16" Width="16" Height="16" Fill="{StaticResource WeatherSunBrush}" />
                </Canvas>
                <Path Data="M36,22 C36,22 46,33 46,39 A10,10 0 0 1 26,39 C26,33 36,22 36,22 Z" Fill="{StaticResource WeatherRainBrush}" Stroke="#FFFFFF" StrokeThickness="2" />
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="WeatherIcon.drop">
        <Viewbox>
            <Canvas Width="48" Height="48">
                <Path Data="M24,6 C24,6 38,22 38,31 A14,14 0 0 1 10,31 C10,22 24,6 24,6 Z" Fill="#10B981" />
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <!-- usage: <ContentControl Content="{Binding Kind}" Style="{StaticResource DecisionIconStyle}" /> (tunda / ekstra / normal) -->
    <Style x:Key="DecisionIconStyle" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="ContentTemplate" Value="{StaticResource WeatherIcon.drop}" />
        <Style.Triggers>
            <Trigger Property="Content" Value="tunda"><Setter Property="ContentTemplate" Value="{StaticResource WeatherIcon.rain}" /></Trigger>
            <Trigger Property="Content" Value="ekstra"><Setter Property="ContentTemplate" Value="{StaticResource WeatherIcon.sundrop}" /></Trigger>
        </Style.Triggers>
    </Style>

    <!-- usage: <ContentControl Content="{Binding WeatherIcon}" Style="{StaticResource WeatherIconStyle}" /> -->
    <Style x:Key="WeatherIconStyle" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="ContentTemplate" Value="{StaticResource WeatherIcon.partly}" />
        <Style.Triggers>
            <Trigger Property="Content" Value="sun"><Setter Property="ContentTemplate" Value="{StaticResource WeatherIcon.sun}" /></Trigger>
            <Trigger Property="Content" Value="cloudy"><Setter Property="ContentTemplate" Value="{StaticResource WeatherIcon.cloudy}" /></Trigger>
            <Trigger Property="Content" Value="rain"><Setter Property="ContentTemplate" Value="{StaticResource WeatherIcon.rain}" /></Trigger>
            <Trigger Property="Content" Value="drizzle"><Setter Property="ContentTemplate" Value="{StaticResource WeatherIcon.drizzle}" /></Trigger>
            <Trigger Property="Content" Value="storm"><Setter Property="ContentTemplate" Value="{StaticResource WeatherIcon.storm}" /></Trigger>
            <Trigger Property="Content" Value="fog"><Setter Property="ContentTemplate" Value="{StaticResource WeatherIcon.fog}" /></Trigger>
            <Trigger Property="Content" Value="offline"><Setter Property="ContentTemplate" Value="{StaticResource WeatherIcon.offline}" /></Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
