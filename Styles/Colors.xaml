<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Primary Forest Greens -->
    <Color x:Key="PrimaryGreenColor">#235D43</Color>
    <Color x:Key="PrimaryGreenHoverColor">#1B4934</Color>
    <Color x:Key="PrimaryGreenDarkColor">#153A2A</Color>
    <SolidColorBrush x:Key="PrimaryGreenBrush" Color="{StaticResource PrimaryGreenColor}" />
    <SolidColorBrush x:Key="PrimaryGreenHoverBrush" Color="{StaticResource PrimaryGreenHoverColor}" />
    <SolidColorBrush x:Key="PrimaryGreenDarkBrush" Color="{StaticResource PrimaryGreenDarkColor}" />

    <!-- Accent Emerald -->
    <Color x:Key="AccentEmeraldColor">#059669</Color>
    <Color x:Key="AccentEmeraldHoverColor">#047857</Color>
    <Color x:Key="AccentEmeraldLightColor">#10B981</Color>
    <SolidColorBrush x:Key="AccentEmeraldBrush" Color="{StaticResource AccentEmeraldColor}" />
    <SolidColorBrush x:Key="AccentEmeraldHoverBrush" Color="{StaticResource AccentEmeraldHoverColor}" />
    <SolidColorBrush x:Key="AccentEmeraldLightBrush" Color="{StaticResource AccentEmeraldLightColor}" />

    <!-- Mint / Sage -->
    <Color x:Key="MintBgColor">#D1FAE5</Color>
    <Color x:Key="MintTextColor">#065F46</Color>
    <Color x:Key="MintBorderColor">#A7F3D0</Color>
    <SolidColorBrush x:Key="MintBgBrush" Color="{StaticResource MintBgColor}" />
    <SolidColorBrush x:Key="MintTextBrush" Color="{StaticResource MintTextColor}" />
    <SolidColorBrush x:Key="MintBorderBrush" Color="{StaticResource MintBorderColor}" />

    <!-- Neutral Backgrounds -->
    <Color x:Key="PageBackgroundColor">#F8FAF9</Color>
    <Color x:Key="CardBackgroundColor">#FFFFFF</Color>
    <Color x:Key="SidebarBackgroundColor">#F8FAF9</Color>
    <Color x:Key="InputBackgroundColor">#FFFFFF</Color>
    <SolidColorBrush x:Key="PageBackgroundBrush" Color="{StaticResource PageBackgroundColor}" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackgroundColor}" />
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="{StaticResource SidebarBackgroundColor}" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{StaticResource InputBackgroundColor}" />

    <!-- Text Colors -->
    <Color x:Key="TextPrimaryColor">#1E293B</Color>
    <Color x:Key="TextSecondaryColor">#64748B</Color>
    <Color x:Key="TextMutedColor">#94A3B8</Color>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="TextWhiteBrush" Color="#FFFFFF" />

    <!-- Input Borders -->
    <Color x:Key="InputBorderColor">#E2E8F0</Color>
    <Color x:Key="InputFocusBorderColor">#10B981</Color>
    <SolidColorBrush x:Key="InputBorderBrush" Color="{StaticResource InputBorderColor}" />
    <SolidColorBrush x:Key="InputFocusBorderBrush" Color="{StaticResource InputFocusBorderColor}" />

    <!-- Danger Red -->
    <Color x:Key="DangerRedColor">#EF4444</Color>
    <Color x:Key="DangerRedHoverColor">#DC2626</Color>
    <Color x:Key="DangerBgColor">#FEE2E2</Color>
    <Color x:Key="DangerTextColor">#DC2626</Color>
    <SolidColorBrush x:Key="DangerRedBrush" Color="{StaticResource DangerRedColor}" />
    <SolidColorBrush x:Key="DangerRedHoverBrush" Color="{StaticResource DangerRedHoverColor}" />
    <SolidColorBrush x:Key="DangerBgBrush" Color="{StaticResource DangerBgColor}" />
    <SolidColorBrush x:Key="DangerTextBrush" Color="{StaticResource DangerTextColor}" />

    <!-- Overlay & Shadows -->
    <SolidColorBrush x:Key="ModalOverlayBrush" Color="#800F172A" />

    <!-- DropShadowEffect for Cards -->
    <DropShadowEffect x:Key="CardShadow"
                      BlurRadius="20"
                      ShadowDepth="4"
                      Direction="270"
                      Color="#000000"
                      Opacity="0.06" />

    <DropShadowEffect x:Key="ModalShadow"
                      BlurRadius="35"
                      ShadowDepth="10"
                      Direction="270"
                      Color="#000000"
                      Opacity="0.18" />

    <DropShadowEffect x:Key="ButtonShadow"
                      BlurRadius="12"
                      ShadowDepth="3"
                      Direction="270"
                      Color="#059669"
                      Opacity="0.25" />

</ResourceDictionary>
