<Window x:Class="Lahanku.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:Lahanku.ViewModels"
        xmlns:views="clr-namespace:Lahanku.Views"
        xmlns:modals="clr-namespace:Lahanku.Views.Modals"
        xmlns:converters="clr-namespace:Lahanku.Converters"
        mc:Ignorable="d"
        Title="LahanKu - Manajemen Lahan Pertanian Cerdas"
        Height="820" Width="1200"
        MinHeight="680" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBackgroundBrush}"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- View Mapping DataTemplates -->
        <DataTemplate DataType="{x:Type viewmodels:LoginViewModel}">
            <views:LoginView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:SignUpViewModel}">
            <views:SignUpView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:LandDetailViewModel}">
            <views:LandDetailView />
        </DataTemplate>

        <!-- Modal Mapping DataTemplates -->
        <DataTemplate DataType="{x:Type viewmodels:LandModalViewModel}">
            <modals:LandModalView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:DeleteConfirmationViewModel}">
            <modals:DeleteConfirmModalView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:IrrigationModalViewModel}">
            <modals:IrrigationModalView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <!-- LAYER 1: CURRENT VIEW -->
        <ContentControl Content="{Binding CurrentView}"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch" />

        <!-- LAYER 2: MODAL OVERLAY -->
        <Grid x:Name="ModalOverlayGrid"
              Background="{StaticResource ModalOverlayBrush}">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ActiveModal, Converter={StaticResource NullToVisibilityConverter}}" Value="Visible">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <!-- Backdrop Click Closes Modal -->
            <Grid Background="Transparent"
                  MouseDown="Backdrop_MouseDown" />

            <!-- Active Modal Content -->
            <ContentControl Content="{Binding ActiveModal}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsHitTestVisible="True" />
        </Grid>

        <!-- LAYER 3: FLOATING TOAST NOTIFICATION (BOTTOM-RIGHT) -->
        <!-- Matches Mockup 5: Light green badge with checkmark "Data berhasil ditambahkan!" -->
        <Border HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,36,36"
                Background="#ECFDF5"
                BorderBrush="{StaticResource AccentEmeraldLightBrush}"
                BorderThickness="1.5"
                CornerRadius="14"
                Padding="18,12"
                Effect="{StaticResource CardShadow}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsToastVisible}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <StackPanel Orientation="Horizontal">
                <!-- Checkmark Icon in Circle -->
                <Border Width="22" Height="22"
                        CornerRadius="11"
                        Background="{StaticResource AccentEmeraldLightBrush}"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center">
                    <Path Data="{StaticResource CheckPath}"
                          Fill="#FFFFFF"
                          Width="12" Height="12"
                          Stretch="Uniform"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
                </Border>

                <!-- Toast Message Text -->
                <TextBlock Text="{Binding ToastMessage}"
                           Foreground="{StaticResource MintTextBrush}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0" />

                <!-- Close Button -->
                <Button Command="{Binding DismissToastCommand}"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        VerticalAlignment="Center"
                        Padding="2">
                    <Path Data="{StaticResource ClosePath}"
                          Fill="{StaticResource TextSecondaryBrush}"
                          Width="10" Height="10"
                          Stretch="Uniform" />
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
