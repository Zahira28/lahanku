<Window x:Class="Lahanku.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:Lahanku.ViewModels"
        xmlns:views="clr-namespace:Lahanku.Views"
        xmlns:modals="clr-namespace:Lahanku.Views.Modals"
        xmlns:converters="clr-namespace:Lahanku.Converters"
        mc:Ignorable="d"
        Title="LahanKu - Manajemen Lahan Pertanian Cerdas"
        Height="820" Width="1200"
        MinHeight="680" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBackgroundBrush}"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- View Mapping DataTemplates -->
        <DataTemplate DataType="{x:Type viewmodels:LoginViewModel}">
            <views:LoginView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:SignUpViewModel}">
            <views:SignUpView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:LandDetailViewModel}">
            <views:LandDetailView />
        </DataTemplate>

        <!-- Modal Mapping DataTemplates -->
        <DataTemplate DataType="{x:Type viewmodels:LandModalViewModel}">
            <modals:LandModalView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:DeleteConfirmationViewModel}">
            <modals:DeleteConfirmModalView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:IrrigationModalViewModel}">
            <modals:IrrigationModalView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:DeleteIrrigationModalViewModel}">
            <modals:DeleteIrrigationModalView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:ErrorModalViewModel}">
            <modals:ErrorModalView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:MapPickerModalViewModel}">
            <modals:MapPickerModalView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <!-- LAYER 1: CURRENT VIEW -->
        <ContentControl Content="{Binding CurrentView}"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch" />

        <!-- LAYER 2: MODAL OVERLAY -->
        <Grid x:Name="ModalOverlayGrid"
              Background="{StaticResource ModalOverlayBrush}">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ActiveModal, Converter={StaticResource NullToVisibilityConverter}}" Value="Visible">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <!-- Backdrop Click Closes Modal -->
            <Grid Background="Transparent"
                  MouseDown="Backdrop_MouseDown" />

            <!-- Active Modal Content -->
            <ContentControl Content="{Binding ActiveModal}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsHitTestVisible="True" />
        </Grid>

        <!-- LAYER 3: FLOATING TOAST NOTIFICATION (BOTTOM-RIGHT) -->
        <Border Panel.ZIndex="999"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,36,36"
                Background="{Binding ToastBackgroundBrush}"
                BorderBrush="{Binding ToastBorderBrush}"
                BorderThickness="1.5"
                CornerRadius="14"
                Padding="18,12"
                Effect="{StaticResource CardShadow}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsToastVisible}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <StackPanel Orientation="Horizontal">
                <!-- Icon in Circle (Dynamic: Check for success, Exclamation for error/warning) -->
                <Border Width="24" Height="24"
                        CornerRadius="12"
                        Background="{Binding ToastIconBackgroundBrush}"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center">
                    <Grid>
                        <!-- Success Check Icon -->
                        <Path Data="{StaticResource CheckPath}"
                              Fill="{Binding ToastIconBrush}"
                              Width="12" Height="12"
                              Stretch="Uniform"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Visibility="{Binding IsSuccessToast, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <!-- Error / Warning Alert Icon -->
                        <Path Data="{StaticResource AlertCirclePath}"
                              Fill="{Binding ToastIconBrush}"
                              Width="14" Height="14"
                              Stretch="Uniform"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSuccessToast}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Grid>
                </Border>

                <!-- Toast Content (Title & Message) -->
                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding ToastTitle}"
                               Foreground="{Binding ToastTitleBrush}"
                               FontSize="12"
                               FontWeight="Bold" />
                    <TextBlock Text="{Binding ToastMessage}"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="13"
                               FontWeight="Medium"
                               MaxWidth="360"
                               TextWrapping="Wrap" />
                </StackPanel>

                <!-- Close Button -->
                <Button Command="{Binding DismissToastCommand}"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        VerticalAlignment="Center"
                        Padding="4">
                    <Path Data="{StaticResource ClosePath}"
                          Fill="{StaticResource TextSecondaryBrush}"
                          Width="10" Height="10"
                          Stretch="Uniform" />
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
