<UserControl x:Class="Lahanku.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:Lahanku.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1100">

    <Grid Background="{StaticResource PageBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <!-- Left Sidebar -->
            <ColumnDefinition Width="240" />
            <!-- Main Content Area -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================= SIDEBAR ================= -->
        <Border Grid.Column="0"
                Background="{StaticResource SidebarBackgroundBrush}"
                BorderBrush="#E2E8F0"
                BorderThickness="0,0,1,0"
                Padding="24,28">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Brand Header -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,36">
                    <Border Width="36"
                            Height="36"
                            CornerRadius="10"
                            Background="{StaticResource AccentEmeraldBrush}"
                            Margin="0,0,12,0">
                        <Path Data="{StaticResource LeafPath}"
                              Fill="#FFFFFF"
                              Width="18"
                              Height="18"
                              Stretch="Uniform"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="LahanKu"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="20"
                               FontWeight="Bold"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Navigation Links -->
                <StackPanel Grid.Row="1">
                    <!-- Ringkasan -->
                    <Border CornerRadius="12"
                            Padding="16,12"
                            Margin="0,0,0,8"
                            Cursor="Hand">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding SelectNavCommand}" CommandParameter="Ringkasan" />
                        </Border.InputBindings>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="Transparent" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSettingsView}" Value="False">
                                        <Setter Property="Background" Value="#E8F5E9" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource HomePath}"
                                  Width="18"
                                  Height="18"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"
                                  Margin="0,0,14,0">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Fill" Value="{StaticResource TextSecondaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSettingsView}" Value="False">
                                                <Setter Property="Fill" Value="{StaticResource PrimaryGreenBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                            <TextBlock Text="Ringkasan"
                                       FontSize="14"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                        <Setter Property="FontWeight" Value="Medium" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSettingsView}" Value="False">
                                                <Setter Property="Foreground" Value="{StaticResource PrimaryGreenBrush}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Pengaturan -->
                    <Border CornerRadius="12"
                            Padding="16,12"
                            Margin="0,0,0,8"
                            Cursor="Hand">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding SelectNavCommand}" CommandParameter="Pengaturan" />
                        </Border.InputBindings>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="Transparent" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSettingsView}" Value="True">
                                        <Setter Property="Background" Value="#E8F5E9" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource SettingsPath}"
                                  Width="18"
                                  Height="18"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"
                                  Margin="0,0,14,0">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Fill" Value="{StaticResource TextSecondaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSettingsView}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource PrimaryGreenBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                            <TextBlock Text="Pengaturan"
                                       FontSize="14"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                        <Setter Property="FontWeight" Value="Medium" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSettingsView}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource PrimaryGreenBrush}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Bottom User Info & Logout -->
                <Border Grid.Row="2"
                        Background="#FFFFFF"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="14,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Avatar icon -->
                        <Border Grid.Column="0"
                                Width="34" Height="34"
                                CornerRadius="17"
                                Background="{StaticResource MintBgBrush}"
                                Margin="0,0,10,0">
                            <Path Data="{StaticResource UserPath}"
                                  Fill="{StaticResource MintTextBrush}"
                                  Width="14" Height="14"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        </Border>

                        <!-- Names -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentUserName}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="12.5"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding CurrentUserUsername}"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="10.5"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <!-- Logout Button -->
                        <Button Grid.Column="2"
                                Command="{Binding LogoutCommand}"
                                ToolTip="Keluar Akun"
                                Style="{StaticResource IconButtonStyle}">
                            <Path Data="{StaticResource ArrowLeftPath}"
                                  Fill="{StaticResource TextSecondaryBrush}"
                                  Width="14" Height="14"
                                  Stretch="Uniform" />
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ================= MAIN CONTENT ================= -->
        <ScrollViewer Grid.Column="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <!-- padding lives here, not on the ScrollViewer, so card shadows don't get clipped -->
            <StackPanel Margin="40,32">
                <!-- Top Header: Subtitle, Greeting, + Add Land Button -->
                <Grid Margin="0,0,0,28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding GreetingText}"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="32"
                                   FontWeight="Bold" />
                    </StackPanel>

                    <!-- + Add Land Button -->
                    <Button Grid.Column="1"
                            Command="{Binding OpenAddLandModalCommand}"
                            ToolTip="Tambah lahan (Ctrl+N)"
                            Style="{StaticResource EmeraldButtonStyle}"
                            Height="44"
                            Padding="20,0"
                            VerticalAlignment="Center"
                            Effect="{StaticResource ButtonShadow}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource PlusPath}"
                                  Fill="#FFFFFF"
                                  Width="14"
                                  Height="14"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"
                                  Margin="0,0,8,0" />
                            <TextBlock Text="Tambah Lahan"
                                       FontWeight="SemiBold"
                                       FontSize="14"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>


                <!-- Error Banner with Retry Button -->
                <Border Background="#FEF2F2"
                        BorderBrush="#FECACA"
                        BorderThickness="1.5"
                        CornerRadius="12"
                        Padding="16,12"
                        Margin="0,0,0,20"
                        Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                            <Border Width="24" Height="24" CornerRadius="12" Background="#FEE2E2" Margin="0,0,12,0">
                                <Path Data="{StaticResource AlertCirclePath}"
                                      Fill="#DC2626"
                                      Width="14" Height="14"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{Binding ErrorMessage}"
                                       Foreground="#991B1B"
                                       FontSize="13"
                                       FontWeight="Medium"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <Button Grid.Column="1"
                                Content="Coba Lagi"
                                Command="{Binding LoadLandsCommand}"
                                Background="#DC2626"
                                Foreground="#FFFFFF"
                                BorderThickness="0"
                                FontWeight="SemiBold"
                                FontSize="12"
                                Padding="14,6"
                                Cursor="Hand"
                                VerticalAlignment="Center">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8" />
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>
                </Border>

                <!-- Today's watering plan: one card per land, all cards in a row share the same height -->
                <StackPanel Margin="0,0,0,32"
                            Visibility="{Binding HasLands, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid Margin="0,0,0,14">
                        <TextBlock Text="Rencana Penyiraman Hari Ini"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding TodayText}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="12.5"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <TextBlock Text="Memuat rencana penyiraman..."
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="13"
                               Margin="0,4,0,4"
                               Visibility="{Binding IsLoadingPlans, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <ItemsControl ItemsSource="{Binding TodayPlans}"
                                  Margin="0,0,-12,0"
                                  Visibility="{Binding IsLoadingPlans, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <!-- UniformGrid gives every cell the same size → equal card heights -->
                                <UniformGrid Columns="3" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource CardBackgroundBrush}"
                                        BorderBrush="#E2E8F0"
                                        BorderThickness="1"
                                        CornerRadius="14"
                                        Padding="16"
                                        Margin="0,0,12,12"
                                        Effect="{StaticResource CardShadow}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="40" />
                                        </Grid.RowDefinitions>

                                        <!-- icon + land name -->
                                        <Grid Grid.Row="0" Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="38" Height="38" CornerRadius="10" Margin="0,0,12,0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#ECFDF5" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Kind}" Value="tunda">
                                                                <Setter Property="Background" Value="#EFF6FF" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Kind}" Value="ekstra">
                                                                <Setter Property="Background" Value="#FFFBEB" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <ContentControl Content="{Binding Kind}" Style="{StaticResource DecisionIconStyle}" Width="22" Height="22" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Land.Name}"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Land.AreaText}"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           FontSize="12" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- title (always reserves 2 lines) + reason (max 3 lines) -->
                                        <StackPanel Grid.Row="1">
                                            <TextBlock Text="{Binding Recommendation.Title}"
                                                       FontSize="13.5"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap"
                                                       LineHeight="18"
                                                       LineStackingStrategy="BlockLineHeight"
                                                       Height="36"
                                                       TextTrimming="CharacterEllipsis">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#047857" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Kind}" Value="tunda">
                                                                <Setter Property="Foreground" Value="#1D4ED8" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Kind}" Value="ekstra">
                                                                <Setter Property="Foreground" Value="#B45309" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding ShortReason}"
                                                       ToolTip="{Binding ShortReason}"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="12"
                                                       TextWrapping="Wrap"
                                                       LineHeight="17"
                                                       LineStackingStrategy="BlockLineHeight"
                                                       MaxHeight="51"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>

                                        <Border Grid.Row="2" Height="1" Background="#F1F5F9" Margin="0,12,0,0" />

                                        <!-- volume + action, fixed height so every footer lines up -->
                                        <Grid Grid.Row="3" VerticalAlignment="Bottom">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding VolumeNumber}"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           FontSize="20"
                                                           FontWeight="Bold"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Text=" L"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Bottom"
                                                           Margin="2,0,0,4" />
                                            </StackPanel>

                                            <!-- postponed: show the routine amount instead of a button -->
                                            <TextBlock Text="{Binding Caption}"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="12"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding IsPostponed, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                            <Button Content="Catat"
                                                    Command="{Binding DataContext.RecordWateringCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Catat penyiraman lahan ini"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Cursor="Hand"
                                                    Visibility="{Binding IsPostponed, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="bd" Background="#F0FDF4" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="8" Padding="14,6">
                                                            <ContentPresenter TextElement.Foreground="#047857" TextElement.FontWeight="SemiBold" TextElement.FontSize="12.5" />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="bd" Property="Background" Value="#DCFCE7" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{Binding WeeklySummaryText}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="12.5"
                               Margin="0,2,0,0"
                               Visibility="{Binding WeeklySummaryText, Converter={StaticResource EmptyStringToVisibilityConverter}, ConverterParameter=Inverse}" />
                </StackPanel>
                <!-- ================= 3 METRIC CARDS: SKELETON SHIMMER STATE ================= -->
                <!-- Visible when IsLoading is True -->
                <Grid Margin="0,0,0,32"
                      Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Skeleton Card 1 -->
                    <Border Grid.Column="0"
                            Background="{StaticResource CardBackgroundBrush}"
                            CornerRadius="18"
                            Padding="22,20"
                            BorderBrush="#F1F5F9"
                            BorderThickness="1"
                            Effect="{StaticResource CardShadow}">
                        <StackPanel>
                            <Grid Margin="0,0,0,20">
                                <Border Style="{StaticResource SkeletonBoxStyle}"
                                        Width="85" Height="12"
                                        CornerRadius="4"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center" />
                                <Border Style="{StaticResource SkeletonBoxStyle}"
                                        Width="36" Height="36"
                                        CornerRadius="18"
                                        HorizontalAlignment="Right" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                <Border Style="{StaticResource SkeletonBoxStyle}"
                                        Width="55" Height="28"
                                        CornerRadius="6"
                                        Margin="0,0,10,0" />
                                <Border Style="{StaticResource SkeletonBoxStyle}"
                                        Width="70" Height="14"
                                        CornerRadius="4"
                                        VerticalAlignment="Bottom"
                                        Margin="0,0,0,4" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Skeleton Card 2 -->
                    <Border Grid.Column="2"
                            Background="{StaticResource CardBackgroundBrush}"
                            CornerRadius="18"
                            Padding="22,20"
                            BorderBrush="#F1F5F9"
                            BorderThickness="1"
                            Effect="{StaticResource CardShadow}">
                        <StackPanel>
                            <Grid Margin="0,0,0,20">
                                <Border Style="{StaticResource SkeletonBoxStyle}"
                                        Width="75" Height="12"
                                        CornerRadius="4"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center" />
                                <Border Style="{StaticResource SkeletonBoxStyle}"
                                        Width="36" Height="36"
                                        CornerRadius="18"
                                        HorizontalAlignment="Right" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                <Border Style="{StaticResource SkeletonBoxStyle}"
                                        Width="55" Height="28"
                                        CornerRadius="6"
                                        Margin="0,0,10,0" />
                                <Border Style="{StaticResource SkeletonBoxStyle}"
                                        Width="80" Height="14"
                                        CornerRadius="4"
                                        VerticalAlignment="Bottom"
                                        Margin="0,0,0,4" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Skeleton Card 3 -->
                    <Border Grid.Column="4"
                            Background="{StaticResource CardBackgroundBrush}"
                            CornerRadius="18"
                            Padding="22,20"
                            BorderBrush="#F1F5F9"
                            BorderThickness="1"
                            Effect="{StaticResource CardShadow}">
                        <StackPanel>
                            <Grid Margin="0,0,0,20">
                                <Border Style="{StaticResource SkeletonBoxStyle}"
                                        Width="95" Height="12"
                                        CornerRadius="4"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center" />
                                <Border Style="{StaticResource SkeletonBoxStyle}"
                                        Width="36" Height="36"
                                        CornerRadius="18"
                                        HorizontalAlignment="Right" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                <Border Style="{StaticResource SkeletonBoxStyle}"
                                        Width="45" Height="28"
                                        CornerRadius="6"
                                        Margin="0,0,10,0" />
                                <Border Style="{StaticResource SkeletonBoxStyle}"
                                        Width="60" Height="14"
                                        CornerRadius="4"
                                        VerticalAlignment="Bottom"
                                        Margin="0,0,0,4" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ================= 3 METRIC CARDS: REAL STATE ================= -->
                <!-- Visible when IsLoading is False -->
                <Grid Margin="0,0,0,32"
                      Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Card 1: TOTAL LANDS -->
                    <Border Grid.Column="0"
                            Background="{StaticResource CardBackgroundBrush}"
                            CornerRadius="18"
                            Padding="22,20"
                            BorderBrush="#F1F5F9"
                            BorderThickness="1"
                            Effect="{StaticResource CardShadow}">
                        <StackPanel>
                            <Grid Margin="0,0,0,16">
                                <TextBlock Text="Total Lahan"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="12.5"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                                <Border HorizontalAlignment="Right"
                                        Width="36" Height="36"
                                        CornerRadius="18"
                                        Background="{StaticResource MintBgBrush}">
                                    <Path Data="{StaticResource PinPath}"
                                          Fill="{StaticResource MintTextBrush}"
                                          Width="16" Height="16"
                                          Stretch="Uniform"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                                </Border>
                            </Grid>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                <TextBlock Text="{Binding TotalLands}"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           FontSize="28"
                                           FontWeight="Bold"
                                           VerticalAlignment="Bottom"
                                           Margin="0,0,8,0" />
                                <TextBlock Text="Lahan Aktif"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="13.5"
                                           VerticalAlignment="Bottom"
                                           Margin="0,0,0,4" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Card 2: LUAS AREA -->
                    <Border Grid.Column="2"
                            Background="{StaticResource CardBackgroundBrush}"
                            CornerRadius="18"
                            Padding="22,20"
                            BorderBrush="#F1F5F9"
                            BorderThickness="1"
                            Effect="{StaticResource CardShadow}">
                        <StackPanel>
                            <Grid Margin="0,0,0,16">
                                <TextBlock Text="Luas Area"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="12.5"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                                <Border HorizontalAlignment="Right"
                                        Width="36" Height="36"
                                        CornerRadius="18"
                                        Background="{StaticResource MintBgBrush}">
                                    <Path Data="{StaticResource GridPath}"
                                          Fill="{StaticResource MintTextBrush}"
                                          Width="16" Height="16"
                                          Stretch="Uniform"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                                </Border>
                            </Grid>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                <TextBlock Text="{Binding TotalArea}"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           FontSize="28"
                                           FontWeight="Bold"
                                           VerticalAlignment="Bottom"
                                           Margin="0,0,8,0" />
                                <TextBlock Text="Hektar Total"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="13.5"
                                           VerticalAlignment="Bottom"
                                           Margin="0,0,0,4" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Card 3: ACTIVE CROPS -->
                    <Border Grid.Column="4"
                            Background="{StaticResource CardBackgroundBrush}"
                            CornerRadius="18"
                            Padding="22,20"
                            BorderBrush="#F1F5F9"
                            BorderThickness="1"
                            Effect="{StaticResource CardShadow}">
                        <StackPanel>
                            <Grid Margin="0,0,0,16">
                                <TextBlock Text="Tanaman Aktif"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="12.5"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                                <Border HorizontalAlignment="Right"
                                        Width="36" Height="36"
                                        CornerRadius="18"
                                        Background="{StaticResource MintBgBrush}">
                                    <Path Data="{StaticResource LeafPath}"
                                          Fill="{StaticResource MintTextBrush}"
                                          Width="16" Height="16"
                                          Stretch="Uniform"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                                </Border>
                            </Grid>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                <TextBlock Text="{Binding TotalVarieties}"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           FontSize="28"
                                           FontWeight="Bold"
                                           VerticalAlignment="Bottom"
                                           Margin="0,0,8,0" />
                                <TextBlock Text="Varietas"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="13.5"
                                           VerticalAlignment="Bottom"
                                           Margin="0,0,0,4" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Section Title -->
                <TextBlock Text="Lahan yang sudah didaftarkan:"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,0,0,16" />

                <!-- ================= SKELETON STATE: LAND CARDS ================= -->
                <!-- Visible when IsLoading is True -->
                <StackPanel Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <!-- Skeleton Land Card 1 -->
                    <Border Background="{StaticResource CardBackgroundBrush}"
                            CornerRadius="16"
                            BorderBrush="#F1F5F9"
                            BorderThickness="1"
                            Padding="20,18"
                            Margin="0,0,0,12"
                            Effect="{StaticResource CardShadow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Style="{StaticResource SkeletonBoxStyle}"
                                    Width="46" Height="46"
                                    CornerRadius="12"
                                    Margin="0,0,16,0" />

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <Border Style="{StaticResource SkeletonBoxStyle}"
                                        Width="180" Height="16"
                                        CornerRadius="4"
                                        HorizontalAlignment="Left"
                                        Margin="0,0,0,8" />
                                <StackPanel Orientation="Horizontal">
                                    <Border Style="{StaticResource SkeletonBoxStyle}"
                                            Width="110" Height="12"
                                            CornerRadius="4"
                                            Margin="0,0,12,0" />
                                    <Border Style="{StaticResource SkeletonBoxStyle}"
                                            Width="90" Height="12"
                                            CornerRadius="4"
                                            Margin="0,0,12,0" />
                                    <Border Style="{StaticResource SkeletonBoxStyle}"
                                            Width="75" Height="12"
                                            CornerRadius="4" />
                                </StackPanel>
                            </StackPanel>

                            <Border Grid.Column="2"
                                    Style="{StaticResource SkeletonBoxStyle}"
                                    Width="24" Height="24"
                                    CornerRadius="12"
                                    VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Skeleton Land Card 2 -->
                    <Border Background="{StaticResource CardBackgroundBrush}"
                            CornerRadius="16"
                            BorderBrush="#F1F5F9"
                            BorderThickness="1"
                            Padding="20,18"
                            Margin="0,0,0,12"
                            Effect="{StaticResource CardShadow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Style="{StaticResource SkeletonBoxStyle}"
                                    Width="46" Height="46"
                                    CornerRadius="12"
                                    Margin="0,0,16,0" />

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <Border Style="{StaticResource SkeletonBoxStyle}"
                                        Width="140" Height="16"
                                        CornerRadius="4"
                                        HorizontalAlignment="Left"
                                        Margin="0,0,0,8" />
                                <StackPanel Orientation="Horizontal">
                                    <Border Style="{StaticResource SkeletonBoxStyle}"
                                            Width="120" Height="12"
                                            CornerRadius="4"
                                            Margin="0,0,12,0" />
                                    <Border Style="{StaticResource SkeletonBoxStyle}"
                                            Width="80" Height="12"
                                            CornerRadius="4" />
                                </StackPanel>
                            </StackPanel>

                            <Border Grid.Column="2"
                                    Style="{StaticResource SkeletonBoxStyle}"
                                    Width="24" Height="24"
                                    CornerRadius="12"
                                    VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Skeleton Land Card 3 -->
                    <Border Background="{StaticResource CardBackgroundBrush}"
                            CornerRadius="16"
                            BorderBrush="#F1F5F9"
                            BorderThickness="1"
                            Padding="20,18"
                            Margin="0,0,0,12"
                            Effect="{StaticResource CardShadow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Style="{StaticResource SkeletonBoxStyle}"
                                    Width="46" Height="46"
                                    CornerRadius="12"
                                    Margin="0,0,16,0" />

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <Border Style="{StaticResource SkeletonBoxStyle}"
                                        Width="210" Height="16"
                                        CornerRadius="4"
                                        HorizontalAlignment="Left"
                                        Margin="0,0,0,8" />
                                <StackPanel Orientation="Horizontal">
                                    <Border Style="{StaticResource SkeletonBoxStyle}"
                                            Width="100" Height="12"
                                            CornerRadius="4"
                                            Margin="0,0,12,0" />
                                    <Border Style="{StaticResource SkeletonBoxStyle}"
                                            Width="95" Height="12"
                                            CornerRadius="4" />
                                </StackPanel>
                            </StackPanel>

                            <Border Grid.Column="2"
                                    Style="{StaticResource SkeletonBoxStyle}"
                                    Width="24" Height="24"
                                    CornerRadius="12"
                                    VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- ================= STATE 1: EMPTY STATE ================= -->
                <!-- Visible when HasLands is False and not loading -->
                <Border Background="{StaticResource CardBackgroundBrush}"
                        CornerRadius="20"
                        Padding="48,56"
                        BorderBrush="#F1F5F9"
                        BorderThickness="1"
                        Effect="{StaticResource CardShadow}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasLands}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <StackPanel HorizontalAlignment="Center">
                        <!-- Big Mint Badge with Leaf -->
                        <Border Width="88" Height="88"
                                CornerRadius="44"
                                Background="{StaticResource MintBgBrush}"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,20">
                            <Path Data="{StaticResource LeafPath}"
                                  Fill="{StaticResource AccentEmeraldBrush}"
                                  Width="38" Height="38"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        </Border>

                        <TextBlock Text="Belum ada lahan"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,8" />

                        <TextBlock Text="Mulai kelola usaha tani Anda dengan menambahkan lahan pertanian pertama di LahanKu."
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="13.5"
                                   TextAlignment="Center"
                                   MaxWidth="380"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,24" />

                        <Button Command="{Binding OpenAddLandModalCommand}"
                                ToolTip="Tambah lahan (Ctrl+N)"
                                Style="{StaticResource OutlineGreenButtonStyle}"
                                HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource PlusPath}"
                                      Fill="{StaticResource AccentEmeraldBrush}"
                                      Width="13" Height="13"
                                      Stretch="Uniform"
                                      VerticalAlignment="Center"
                                      Margin="0,0,8,0" />
                                <TextBlock Text="Tambah Lahan Utama"
                                           FontWeight="SemiBold"
                                           FontSize="13.5"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- ================= STATE 2: POPULATED LIST ================= -->
                <!-- Visible when HasLands is True and not loading -->
                <ItemsControl ItemsSource="{Binding Lands}">
                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasLands}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource CardBackgroundBrush}"
                                    CornerRadius="16"
                                    BorderBrush="#F1F5F9"
                                    BorderThickness="1"
                                    Padding="20,18"
                                    Margin="0,0,0,12"
                                    Effect="{StaticResource CardShadow}"
                                    Cursor="Hand"
                                    MouseLeftButtonUp="LandCard_MouseLeftButtonUp">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <!-- Map Icon -->
                                        <ColumnDefinition Width="Auto" />
                                        <!-- Details -->
                                        <ColumnDefinition Width="*" />
                                        <!-- Kebab Menu Button -->
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Map Icon in Light Mint Box -->
                                    <Border Grid.Column="0"
                                            Width="46" Height="46"
                                            CornerRadius="12"
                                            Background="{StaticResource MintBgBrush}"
                                            Margin="0,0,16,0"
                                            VerticalAlignment="Center">
                                        <Path Data="{StaticResource MapPath}"
                                              Fill="{StaticResource AccentEmeraldBrush}"
                                              Width="22" Height="22"
                                              Stretch="Uniform"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                    </Border>

                                    <!-- Land Name & Details -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontSize="16"
                                                   FontWeight="Bold"
                                                   Margin="0,0,0,6" />

                                        <StackPanel Orientation="Horizontal">
                                            <!-- Pin & Coordinate -->
                                            <Path Data="{StaticResource PinPath}"
                                                  Fill="#EF4444"
                                                  Width="12" Height="12"
                                                  Stretch="Uniform"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,4,0" />
                                            <TextBlock Text="{Binding CoordinateText}"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="12.5"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,14,0" />

                                            <!-- Crop Type with plant badge -->
                                            <Path Data="{StaticResource LeafPath}"
                                                  Fill="{StaticResource MintTextBrush}"
                                                  Width="12"
                                                  Height="12"
                                                  Stretch="Uniform"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,5,0" />
                                            <TextBlock Text="{Binding CropType}"
                                                       Foreground="{StaticResource MintTextBrush}"
                                                       FontWeight="SemiBold"
                                                       FontSize="12.5"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Kebab Button (Three Dots) with Popup/ContextMenu -->
                                    <Button Grid.Column="2"
                                            Style="{StaticResource KebabButtonStyle}"
                                            Click="KebabButton_Click"
                                            VerticalAlignment="Center">
                                        <Button.ContextMenu>
                                            <ContextMenu Style="{StaticResource ModernContextMenuStyle}">
                                                <!-- Edit Item -->
                                                <MenuItem Header="Edit Lahan"
                                                          Click="EditMenuItem_Click"
                                                          Style="{StaticResource ModernMenuItemStyle}">
                                                    <MenuItem.Icon>
                                                        <Path Data="{StaticResource PencilPath}"
                                                              Fill="{StaticResource TextSecondaryBrush}"
                                                              Width="14" Height="14"
                                                              Stretch="Uniform" />
                                                    </MenuItem.Icon>
                                                </MenuItem>

                                                <!-- Subtle Separator -->
                                                <Separator Background="#F1F5F9" Margin="4,3" Height="1" />

                                                <!-- Delete Item (Red Danger) -->
                                                <MenuItem Header="Hapus Lahan"
                                                          Click="DeleteMenuItem_Click"
                                                          Style="{StaticResource ModernDangerMenuItemStyle}">
                                                    <MenuItem.Icon>
                                                        <Path Data="{StaticResource TrashPath}"
                                                              Fill="{StaticResource DangerRedBrush}"
                                                              Width="14" Height="14"
                                                              Stretch="Uniform" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
