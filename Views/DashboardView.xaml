<UserControl x:Class="Lahanku.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:Lahanku.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1100">

    <Grid Background="{StaticResource PageBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <!-- Left Sidebar -->
            <ColumnDefinition Width="240" />
            <!-- Main Content Area -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================= SIDEBAR ================= -->
        <Border Grid.Column="0"
                Background="{StaticResource SidebarBackgroundBrush}"
                BorderBrush="#E2E8F0"
                BorderThickness="0,0,1,0"
                Padding="24,28">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Brand Header -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,36">
                    <Border Width="36"
                            Height="36"
                            CornerRadius="10"
                            Background="{StaticResource AccentEmeraldBrush}"
                            Margin="0,0,12,0">
                        <Path Data="{StaticResource LeafPath}"
                              Fill="#FFFFFF"
                              Width="18"
                              Height="18"
                              Stretch="Uniform"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="LahanKu"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="20"
                               FontWeight="Bold"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Navigation Links -->
                <StackPanel Grid.Row="1">
                    <!-- Ringkasan -->
                    <Border CornerRadius="12"
                            Padding="16,12"
                            Margin="0,0,0,8"
                            Cursor="Hand">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding SelectNavCommand}" CommandParameter="Ringkasan" />
                        </Border.InputBindings>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="Transparent" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSettingsView}" Value="False">
                                        <Setter Property="Background" Value="#E8F5E9" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource HomePath}"
                                  Width="18"
                                  Height="18"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"
                                  Margin="0,0,14,0">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Fill" Value="{StaticResource TextSecondaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSettingsView}" Value="False">
                                                <Setter Property="Fill" Value="{StaticResource PrimaryGreenBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                            <TextBlock Text="Ringkasan"
                                       FontSize="14"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                        <Setter Property="FontWeight" Value="Medium" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSettingsView}" Value="False">
                                                <Setter Property="Foreground" Value="{StaticResource PrimaryGreenBrush}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Pengaturan -->
                    <Border CornerRadius="12"
                            Padding="16,12"
                            Margin="0,0,0,8"
                            Cursor="Hand">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding SelectNavCommand}" CommandParameter="Pengaturan" />
                        </Border.InputBindings>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="Transparent" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSettingsView}" Value="True">
                                        <Setter Property="Background" Value="#E8F5E9" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource SettingsPath}"
                                  Width="18"
                                  Height="18"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"
                                  Margin="0,0,14,0">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Fill" Value="{StaticResource TextSecondaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSettingsView}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource PrimaryGreenBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                            <TextBlock Text="Pengaturan"
                                       FontSize="14"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                        <Setter Property="FontWeight" Value="Medium" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSettingsView}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource PrimaryGreenBrush}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Bottom User Info & Logout -->
                <Border Grid.Row="2"
                        Background="#FFFFFF"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="14,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Avatar icon -->
                        <Border Grid.Column="0"
                                Width="34" Height="34"
                                CornerRadius="17"
                                Background="{StaticResource MintBgBrush}"
                                Margin="0,0,10,0">
                            <Path Data="{StaticResource UserPath}"
                                  Fill="{StaticResource MintTextBrush}"
                                  Width="14" Height="14"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        </Border>

                        <!-- Names -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentUserName}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="12.5"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="Penggiat Urban Farm"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="10.5" />
                        </StackPanel>

                        <!-- Logout Button -->
                        <Button Grid.Column="2"
                                Command="{Binding LogoutCommand}"
                                ToolTip="Keluar Akun"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Padding="4">
                            <Path Data="{StaticResource ArrowLeftPath}"
                                  Fill="{StaticResource TextSecondaryBrush}"
                                  Width="14" Height="14"
                                  Stretch="Uniform" />
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ================= MAIN CONTENT ================= -->
        <ScrollViewer Grid.Column="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="40,32">
            <StackPanel>
                <!-- Top Header: Subtitle, Greeting, + Tambah Lahan Button -->
                <Grid Margin="0,0,0,28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="LAHANKU • SISTEM MANAJEMEN LAHAN"
                                   Foreground="{StaticResource AccentEmeraldBrush}"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Margin="0,0,0,4" />

                        <TextBlock Text="{Binding GreetingText}"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="32"
                                   FontWeight="Bold" />
                    </StackPanel>

                    <!-- + Tambah Lahan Button -->
                    <Button Grid.Column="1"
                            Command="{Binding OpenAddLandModalCommand}"
                            Style="{StaticResource EmeraldButtonStyle}"
                            Height="44"
                            Padding="20,0"
                            VerticalAlignment="Center"
                            Effect="{StaticResource ButtonShadow}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource PlusPath}"
                                  Fill="#FFFFFF"
                                  Width="14"
                                  Height="14"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"
                                  Margin="0,0,8,0" />
                            <TextBlock Text="Tambah Lahan"
                                       FontWeight="SemiBold"
                                       FontSize="14"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- 3 Metric Cards in a Row -->
                <Grid Margin="0,0,0,32">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Card 1: TOTAL LAHAN -->
                    <Border Grid.Column="0"
                            Background="{StaticResource CardBackgroundBrush}"
                            CornerRadius="18"
                            Padding="22,20"
                            BorderBrush="#F1F5F9"
                            BorderThickness="1"
                            Effect="{StaticResource CardShadow}">
                        <StackPanel>
                            <Grid Margin="0,0,0,16">
                                <TextBlock Text="TOTAL LAHAN"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                                <Border HorizontalAlignment="Right"
                                        Width="36" Height="36"
                                        CornerRadius="18"
                                        Background="{StaticResource MintBgBrush}">
                                    <Path Data="{StaticResource PinPath}"
                                          Fill="{StaticResource MintTextBrush}"
                                          Width="16" Height="16"
                                          Stretch="Uniform"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                                </Border>
                            </Grid>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                <TextBlock Text="{Binding TotalLands}"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           FontSize="28"
                                           FontWeight="Bold"
                                           Margin="0,0,8,0" />
                                <TextBlock Text="Lahan Aktif"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="13"
                                           VerticalAlignment="Center"
                                           Margin="0,0,0,4" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Card 2: LUAS AREA -->
                    <Border Grid.Column="2"
                            Background="{StaticResource CardBackgroundBrush}"
                            CornerRadius="18"
                            Padding="22,20"
                            BorderBrush="#F1F5F9"
                            BorderThickness="1"
                            Effect="{StaticResource CardShadow}">
                        <StackPanel>
                            <Grid Margin="0,0,0,16">
                                <TextBlock Text="LUAS AREA"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                                <Border HorizontalAlignment="Right"
                                        Width="36" Height="36"
                                        CornerRadius="18"
                                        Background="{StaticResource MintBgBrush}">
                                    <Path Data="{StaticResource GridPath}"
                                          Fill="{StaticResource MintTextBrush}"
                                          Width="16" Height="16"
                                          Stretch="Uniform"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                                </Border>
                            </Grid>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                <TextBlock Text="{Binding TotalArea}"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           FontSize="28"
                                           FontWeight="Bold"
                                           Margin="0,0,8,0" />
                                <TextBlock Text="Hektar Total"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="13"
                                           VerticalAlignment="Center"
                                           Margin="0,0,0,4" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Card 3: TANAMAN AKTIF -->
                    <Border Grid.Column="4"
                            Background="{StaticResource CardBackgroundBrush}"
                            CornerRadius="18"
                            Padding="22,20"
                            BorderBrush="#F1F5F9"
                            BorderThickness="1"
                            Effect="{StaticResource CardShadow}">
                        <StackPanel>
                            <Grid Margin="0,0,0,16">
                                <TextBlock Text="TANAMAN AKTIF"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                                <Border HorizontalAlignment="Right"
                                        Width="36" Height="36"
                                        CornerRadius="18"
                                        Background="{StaticResource MintBgBrush}">
                                    <Path Data="{StaticResource LeafPath}"
                                          Fill="{StaticResource MintTextBrush}"
                                          Width="16" Height="16"
                                          Stretch="Uniform"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                                </Border>
                            </Grid>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                <TextBlock Text="{Binding TotalVarieties}"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           FontSize="28"
                                           FontWeight="Bold"
                                           Margin="0,0,8,0" />
                                <TextBlock Text="Varietas"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="13"
                                           VerticalAlignment="Center"
                                           Margin="0,0,0,4" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Section Title -->
                <TextBlock Text="Lahan yang sudah didaftarkan:"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,0,0,16" />

                <!-- ================= STATE 1: EMPTY STATE ================= -->
                <!-- Visible when HasLands is False -->
                <Border Background="{StaticResource CardBackgroundBrush}"
                        CornerRadius="20"
                        Padding="48,56"
                        BorderBrush="#F1F5F9"
                        BorderThickness="1"
                        Effect="{StaticResource CardShadow}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasLands}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <StackPanel HorizontalAlignment="Center">
                        <!-- Big Mint Badge with Leaf -->
                        <Border Width="88" Height="88"
                                CornerRadius="44"
                                Background="{StaticResource MintBgBrush}"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,20">
                            <Path Data="{StaticResource LeafPath}"
                                  Fill="{StaticResource AccentEmeraldBrush}"
                                  Width="38" Height="38"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        </Border>

                        <TextBlock Text="Belum ada lahan"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,8" />

                        <TextBlock Text="Mulai kelola usaha tani Anda dengan menambahkan lahan pertanian pertama di LahanKu."
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="13.5"
                                   TextAlignment="Center"
                                   MaxWidth="380"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,24" />

                        <Button Command="{Binding OpenAddLandModalCommand}"
                                Style="{StaticResource OutlineGreenButtonStyle}"
                                HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource PlusPath}"
                                      Fill="{StaticResource AccentEmeraldBrush}"
                                      Width="13" Height="13"
                                      Stretch="Uniform"
                                      VerticalAlignment="Center"
                                      Margin="0,0,8,0" />
                                <TextBlock Text="Tambah Lahan Utama"
                                           FontWeight="SemiBold"
                                           FontSize="13.5"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- ================= STATE 2: POPULATED LIST ================= -->
                <!-- Visible when HasLands is True -->
                <ItemsControl ItemsSource="{Binding Lands}">
                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasLands}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource CardBackgroundBrush}"
                                    CornerRadius="16"
                                    BorderBrush="#F1F5F9"
                                    BorderThickness="1"
                                    Padding="20,18"
                                    Margin="0,0,0,12"
                                    Effect="{StaticResource CardShadow}"
                                    Cursor="Hand"
                                    MouseLeftButtonUp="LandCard_MouseLeftButtonUp">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <!-- Map Icon -->
                                        <ColumnDefinition Width="Auto" />
                                        <!-- Details -->
                                        <ColumnDefinition Width="*" />
                                        <!-- Kebab Menu Button -->
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Map Icon in Light Mint Box -->
                                    <Border Grid.Column="0"
                                            Width="46" Height="46"
                                            CornerRadius="12"
                                            Background="{StaticResource MintBgBrush}"
                                            Margin="0,0,16,0"
                                            VerticalAlignment="Center">
                                        <Path Data="{StaticResource MapPath}"
                                              Fill="{StaticResource AccentEmeraldBrush}"
                                              Width="22" Height="22"
                                              Stretch="Uniform"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                    </Border>

                                    <!-- Land Name & Details -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontSize="16"
                                                   FontWeight="Bold"
                                                   Margin="0,0,0,6" />

                                        <StackPanel Orientation="Horizontal">
                                            <!-- Pin & Coordinate -->
                                            <Path Data="{StaticResource PinPath}"
                                                  Fill="#EF4444"
                                                  Width="12" Height="12"
                                                  Stretch="Uniform"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,4,0" />
                                            <TextBlock Text="{Binding CoordinateText}"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="12.5"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,14,0" />

                                            <!-- Crop Type with plant badge -->
                                            <TextBlock Text="🌾"
                                                       FontSize="12"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,4,0" />
                                            <TextBlock Text="{Binding CropType}"
                                                       Foreground="{StaticResource MintTextBrush}"
                                                       FontWeight="SemiBold"
                                                       FontSize="12.5"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Kebab Button (Three Dots) with Popup/ContextMenu -->
                                    <Button Grid.Column="2"
                                            Style="{StaticResource KebabButtonStyle}"
                                            Click="KebabButton_Click"
                                            VerticalAlignment="Center">
                                        <Button.ContextMenu>
                                            <ContextMenu Background="#FFFFFF"
                                                         BorderBrush="#E2E8F0"
                                                         BorderThickness="1"
                                                         Padding="4">
                                                <!-- Edit Item -->
                                                <MenuItem Header="Edit Lahan"
                                                          Click="EditMenuItem_Click"
                                                          Padding="10,8"
                                                          FontSize="13.5"
                                                          FontWeight="Medium"
                                                          Foreground="{StaticResource TextPrimaryBrush}">
                                                    <MenuItem.Icon>
                                                        <Path Data="{StaticResource PencilPath}"
                                                              Fill="{StaticResource TextSecondaryBrush}"
                                                              Width="14" Height="14"
                                                              Stretch="Uniform" />
                                                    </MenuItem.Icon>
                                                </MenuItem>

                                                <!-- Delete Item (Red) -->
                                                <MenuItem Header="Hapus Lahan"
                                                          Click="DeleteMenuItem_Click"
                                                          Background="{StaticResource DangerBgBrush}"
                                                          Foreground="{StaticResource DangerRedBrush}"
                                                          FontWeight="SemiBold"
                                                          Padding="10,8"
                                                          FontSize="13.5"
                                                          Margin="0,2,0,0">
                                                    <MenuItem.Icon>
                                                        <Path Data="{StaticResource TrashPath}"
                                                              Fill="{StaticResource DangerRedBrush}"
                                                              Width="14" Height="14"
                                                              Stretch="Uniform" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
