<UserControl x:Class="Lahanku.Views.LandDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:Lahanku.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1100">

    <Grid Background="{StaticResource PageBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <!-- Left Sidebar -->
            <ColumnDefinition Width="240" />
            <!-- Main Content Area -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <controls:Sidebar Grid.Column="0" ActiveItem="Ringkasan" />

        <!-- ================= MAIN CONTENT ================= -->
        <!-- the page doesn't scroll; the history card fills the remaining height and its list scrolls inside the card -->
        <Grid Grid.Column="1" Margin="40,32">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <!-- Back Button + Header Info -->
                <Grid Grid.Row="0" Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Back Button -->
                    <Button Grid.Column="0"
                            Command="{Binding BackToDashboardCommand}"
                            ToolTip="Kembali ke Ringkasan (Esc)"
                            Background="#FFFFFF"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            Width="42" Height="42"
                            Cursor="Hand"
                            Margin="0,6,18,0"
                            VerticalAlignment="Top">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="btnBorder"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="21">
                                    <Path Data="{StaticResource ArrowLeftPath}"
                                          Fill="{StaticResource TextSecondaryBrush}"
                                          Width="16" Height="16"
                                          Stretch="Uniform"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="btnBorder" Property="Background" Value="#F1F5F9" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Titles -->
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Land.Name, StringFormat='Detail {0}'}"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="32"
                                   FontWeight="Bold"
                                   Margin="0,0,0,4" />

                        <TextBlock Text="{Binding Land.SubtitleText}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="13.5" />
                    </StackPanel>
                </Grid>

                <!-- ================= CLIMATE-SMART WEATHER & IRRIGATION ADVISOR (OPEN-METEO & SDG 13) ================= -->
                <Grid Grid.Row="1" Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="1.8*" />
                    </Grid.ColumnDefinitions>

                    <!-- CARD 1: OPEN-METEO SATELLITE WEATHER (REAL-TIME) -->
                    <Border Grid.Column="0"
                            Background="{StaticResource CardBackgroundBrush}"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="20"
                            Margin="0,0,16,0"
                            Effect="{StaticResource CardShadow}">
                        <Grid>
                            <!-- Skeleton State (Visible when IsLoadingWeather is True) -->
                            <Grid Visibility="{Binding IsLoadingWeather, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,16">
                                    <Border Style="{StaticResource SkeletonBoxStyle}" Width="130" Height="13" CornerRadius="4" HorizontalAlignment="Left" />
                                    <Border Style="{StaticResource SkeletonBoxStyle}" Width="24" Height="24" CornerRadius="12" HorizontalAlignment="Right" />
                                </Grid>

                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,18">
                                    <Border Style="{StaticResource SkeletonBoxStyle}" Width="40" Height="40" CornerRadius="20" Margin="0,0,14,0" />
                                    <StackPanel VerticalAlignment="Center">
                                        <Border Style="{StaticResource SkeletonBoxStyle}" Width="75" Height="22" CornerRadius="4" Margin="0,0,0,6" />
                                        <Border Style="{StaticResource SkeletonBoxStyle}" Width="110" Height="12" CornerRadius="4" />
                                    </StackPanel>
                                </StackPanel>

                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource SkeletonBoxStyle}" Height="46" CornerRadius="10" Margin="0,0,6,0" />
                                    <Border Grid.Column="1" Style="{StaticResource SkeletonBoxStyle}" Height="46" CornerRadius="10" Margin="6,0,0,0" />
                                </Grid>
                            </Grid>

                            <!-- Real Content (Visible when IsLoadingWeather is False) -->
                            <Grid Visibility="{Binding IsLoadingWeather, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- Header: Title + Refresh Button -->
                                <Grid Grid.Row="0" Margin="0,0,0,12">
                                    <TextBlock Text="Cuaca Saat Ini"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />

                                    <Button Command="{Binding RefreshWeatherCommand}"
                                            HorizontalAlignment="Right"
                                            Style="{StaticResource IconButtonStyle}"
                                            ToolTip="Segarkan cuaca (F5)">
                                        <TextBlock Text="&#xE72C;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="13"
                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                    </Button>
                                </Grid>

                                <!-- Weather Hero: Big Emoji + Temperature & Condition -->
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
                                    <ContentControl Content="{Binding WeatherIcon}"
                                                    Style="{StaticResource WeatherIconStyle}"
                                                    Width="52"
                                                    Height="52"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,14,0" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding WeatherTempText}"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontSize="24"
                                                   FontWeight="Bold" />
                                        <TextBlock Text="{Binding WeatherConditionText}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="12.5"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Weather Detail Pills -->
                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Humidity -->
                                    <Border Grid.Column="0"
                                            Background="#F8FAFC"
                                            CornerRadius="10"
                                            Padding="10,8"
                                            Margin="0,0,6,0">
                                        <StackPanel>
                                            <TextBlock Text="Kelembapan"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       FontSize="10"
                                                       FontWeight="Medium" />
                                            <TextBlock Text="{Binding WeatherHumidityText}"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       FontSize="13"
                                                       FontWeight="Bold" />

                                            <!-- compared with the land's ideal humidity -->
                                            <StackPanel Orientation="Horizontal"
                                                        Margin="0,3,0,0"
                                                        Visibility="{Binding HumidityStatusText, Converter={StaticResource EmptyStringToVisibilityConverter}, ConverterParameter=Inverse}">
                                                <TextBlock Text="{Binding HumidityIdealText}"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           FontSize="10"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Text=" · "
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           FontSize="10"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding HumidityStatusText}"
                                                           FontSize="10"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#059669" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HumidityStatus}" Value="low">
                                                                    <Setter Property="Foreground" Value="#D97706" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding HumidityStatus}" Value="high">
                                                                    <Setter Property="Foreground" Value="#2563EB" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Rainfall -->
                                    <Border Grid.Column="1"
                                            Background="#F8FAFC"
                                            CornerRadius="10"
                                            Padding="10,8"
                                            Margin="6,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Curah Hujan"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       FontSize="10"
                                                       FontWeight="Medium" />
                                            <TextBlock Text="{Binding WeatherPrecipText}"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       FontSize="13"
                                                       FontWeight="Bold" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- CARD 2: today's watering recommendation -->
                    <Border Grid.Column="1"
                            Background="{StaticResource CardBackgroundBrush}"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="20"
                            Effect="{StaticResource CardShadow}">
                        <Grid>
                            <!-- skeleton while weather loads -->
                            <Grid Visibility="{Binding IsLoadingWeather, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Style="{StaticResource SkeletonBoxStyle}" Width="150" Height="14" CornerRadius="4" HorizontalAlignment="Left" Margin="0,0,0,16" />
                                <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Top">
                                    <Border Style="{StaticResource SkeletonBoxStyle}" Width="44" Height="44" CornerRadius="12" Margin="0,0,14,0" />
                                    <StackPanel>
                                        <Border Style="{StaticResource SkeletonBoxStyle}" Width="220" Height="16" CornerRadius="4" Margin="0,2,0,10" />
                                        <Border Style="{StaticResource SkeletonBoxStyle}" Width="320" Height="12" CornerRadius="4" Margin="0,0,0,6" />
                                        <Border Style="{StaticResource SkeletonBoxStyle}" Width="260" Height="12" CornerRadius="4" />
                                    </StackPanel>
                                </StackPanel>
                                <Border Grid.Row="2" Style="{StaticResource SkeletonBoxStyle}" Height="14" CornerRadius="4" Width="300" HorizontalAlignment="Left" />
                            </Grid>

                            <!-- real content -->
                            <Grid Visibility="{Binding IsLoadingWeather, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Text="Rekomendasi Hari Ini"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,14" />

                                <Grid Grid.Row="1" VerticalAlignment="Top">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Width="44" Height="44" CornerRadius="12" VerticalAlignment="Top" Margin="0,0,14,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#ECFDF5" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding TodayKind}" Value="tunda">
                                                        <Setter Property="Background" Value="#EFF6FF" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding TodayKind}" Value="ekstra">
                                                        <Setter Property="Background" Value="#FFFBEB" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <ContentControl Content="{Binding TodayKind}" Style="{StaticResource DecisionIconStyle}" Width="26" Height="26" />
                                    </Border>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding AdviceStatus}" FontSize="16" FontWeight="Bold" Margin="0,0,0,6">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#047857" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding TodayKind}" Value="tunda">
                                                            <Setter Property="Foreground" Value="#1D4ED8" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding TodayKind}" Value="ekstra">
                                                            <Setter Property="Foreground" Value="#B45309" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding AdviceText}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="12.5"
                                                   TextWrapping="Wrap"
                                                   LineHeight="18" />
                                    </StackPanel>
                                </Grid>

                                <Border Grid.Row="2" Height="1" Background="#F1F5F9" Margin="0,14,0,12" />

                                <Grid Grid.Row="3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Kebutuhan normal: " Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" />
                                        <TextBlock Text="{Binding BaselineVolumeText}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12.5" FontWeight="SemiBold" />
                                        <TextBlock Text="  ·  Rekomendasi hari ini: " Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" />
                                        <TextBlock Text="{Binding RecommendedVolumeText}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12.5" FontWeight="SemiBold" />
                                    </StackPanel>

                                    <Button Grid.Column="1"
                                            Command="{Binding ApplyRecommendedIrrigationCommand}"
                                            Visibility="{Binding CanApplyAdvice, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            ToolTip="Catat penyiraman sesuai rekomendasi"
                                            Height="34"
                                            Padding="14,0"
                                            Background="{StaticResource AccentEmeraldBrush}"
                                            BorderThickness="0"
                                            Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="btnBdr"
                                                        Background="{TemplateBinding Background}"
                                                        CornerRadius="17"
                                                        Padding="{TemplateBinding Padding}">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Path Data="{StaticResource WaterDropPath}"
                                                              Fill="#FFFFFF"
                                                              Width="12"
                                                              Height="12"
                                                              Stretch="Uniform"
                                                              VerticalAlignment="Center"
                                                              Margin="0,0,6,0" />
                                                        <TextBlock Text="Siram Sesuai Anjuran"
                                                                   FontWeight="SemiBold"
                                                                   FontSize="12"
                                                                   Foreground="#FFFFFF" />
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="btnBdr" Property="Background" Value="#047857" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Sub-header Row: Tabs & "+ Water Land" Button -->
                <Grid Grid.Row="2" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Tabs -->
                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Bottom">
                        <!-- Watering Tab (Active) -->
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Text="Penyiraman"
                                       Foreground="{StaticResource PrimaryGreenBrush}"
                                       FontWeight="Bold"
                                       FontSize="15"
                                       Margin="0,0,0,8" />
                            <Border Height="3"
                                    Background="{StaticResource PrimaryGreenBrush}"
                                    CornerRadius="1.5" />
                        </StackPanel>
                    </StackPanel>

                    <!-- + Water Land Button -->
                    <Button Grid.Column="1"
                            Command="{Binding OpenAddIrrigationModalCommand}"
                            ToolTip="Catat penyiraman (Ctrl+N)"
                            Style="{StaticResource EmeraldButtonStyle}"
                            Height="44"
                            Padding="22,0"
                            VerticalAlignment="Center"
                            Effect="{StaticResource ButtonShadow}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource PlusPath}"
                                  Fill="#FFFFFF"
                                  Width="14"
                                  Height="14"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"
                                  Margin="0,0,8,0" />
                            <TextBlock Text="Siram Lahan"
                                       FontWeight="SemiBold"
                                       FontSize="14"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Table Card -->
                <Border Grid.Row="3" Background="{StaticResource CardBackgroundBrush}"
                        CornerRadius="16"
                        BorderBrush="#F1F5F9"
                        BorderThickness="1"
                        Padding="24,18"
                        Effect="{StaticResource CardShadow}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="VerticalAlignment" Value="Top" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding HasLogs}" Value="False" />
                                        <Condition Binding="{Binding IsLoadingLogs}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="VerticalAlignment" Value="Stretch" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <!-- Table Column Headers -->
                        <Grid Margin="12,8,12,14">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding HasLogs}" Value="False" />
                                                <Condition Binding="{Binding IsLoadingLogs}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                    <Setter Property="FontSize" Value="12" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Style>
                            </Grid.Resources>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="80" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Tanggal &amp; Waktu" />
                            <TextBlock Grid.Column="1" Text="Volume" />
                            <TextBlock Grid.Column="2" Text="Rekomendasi" />
                            <TextBlock Grid.Column="3" Text="Evaluasi" />
                            <TextBlock Grid.Column="4" Text="Catatan" />
                            <TextBlock Grid.Column="5" Text="Aksi" HorizontalAlignment="Right" Margin="0,0,8,0" />
                        </Grid>

                        <!-- ================= SKELETON STATE: LOGS ================= -->
                        <!-- Visible when IsLoadingLogs is True -->
                        <StackPanel Grid.Row="1" Visibility="{Binding IsLoadingLogs, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Border BorderBrush="#F8FAFC" BorderThickness="0,0,0,1" Padding="12,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource SkeletonBoxStyle}" Width="150" Height="14" CornerRadius="4" HorizontalAlignment="Left" />
                                    <Border Grid.Column="1" Style="{StaticResource SkeletonBoxStyle}" Width="85" Height="22" CornerRadius="8" HorizontalAlignment="Left" />
                                    <Border Grid.Column="2" Style="{StaticResource SkeletonBoxStyle}" Width="200" Height="14" CornerRadius="4" HorizontalAlignment="Left" />
                                    <Border Grid.Column="3" Style="{StaticResource SkeletonBoxStyle}" Width="65" Height="24" CornerRadius="6" HorizontalAlignment="Right" />
                                </Grid>
                            </Border>
                            <Border BorderBrush="#F8FAFC" BorderThickness="0,0,0,1" Padding="12,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource SkeletonBoxStyle}" Width="130" Height="14" CornerRadius="4" HorizontalAlignment="Left" />
                                    <Border Grid.Column="1" Style="{StaticResource SkeletonBoxStyle}" Width="90" Height="22" CornerRadius="8" HorizontalAlignment="Left" />
                                    <Border Grid.Column="2" Style="{StaticResource SkeletonBoxStyle}" Width="160" Height="14" CornerRadius="4" HorizontalAlignment="Left" />
                                    <Border Grid.Column="3" Style="{StaticResource SkeletonBoxStyle}" Width="65" Height="24" CornerRadius="6" HorizontalAlignment="Right" />
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- Rows (Empty State if no logs) -->
                        <!-- Empty state: fill the remaining card height when there's no history yet -->
                        <Grid Grid.Row="2">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding HasLogs}" Value="False" />
                                                <Condition Binding="{Binding IsLoadingLogs}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>

                            <!-- DownOnly: shrinks itself when the window is short, never grows -->
                            <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,12">
                                <Grid Width="112" Height="112" HorizontalAlignment="Center" Margin="0,0,0,22">
                                    <Ellipse Fill="#F0FDF4" />
                                    <Border Width="80" Height="80"
                                            CornerRadius="40"
                                            Background="{StaticResource MintBgBrush}">
                                        <Path Data="{StaticResource WaterDropPath}"
                                              Fill="{StaticResource AccentEmeraldBrush}"
                                              Width="34" Height="34"
                                              Stretch="Uniform"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                    </Border>
                                </Grid>

                                <TextBlock Text="Belum ada riwayat penyiraman"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           FontSize="19"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,8" />

                                <TextBlock Text="Catat penyiraman pertama untuk mulai memantau pemakaian air di lahan ini."
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="13.5"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           MaxWidth="360"
                                           Margin="0,0,0,24" />

                                <Button Command="{Binding OpenAddIrrigationModalCommand}"
                                        ToolTip="Catat penyiraman (Ctrl+N)"
                                        Style="{StaticResource OutlineGreenButtonStyle}"
                                        HorizontalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource PlusPath}"
                                              Fill="{StaticResource AccentEmeraldBrush}"
                                              Width="13" Height="13"
                                              Stretch="Uniform"
                                              VerticalAlignment="Center"
                                              Margin="0,0,8,0" />
                                        <TextBlock Text="Catat Penyiraman Pertama"
                                                   FontWeight="SemiBold"
                                                   FontSize="13.5"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <TextBlock Text="atau tekan Ctrl+N"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="11.5"
                                           HorizontalAlignment="Center"
                                           Margin="0,10,0,0" />
                            </StackPanel>
                            </Viewbox>
                        </Grid>

                        <!-- Items List -->
                        <!-- hidden when empty, otherwise it covers the button in the empty state -->
                        <ScrollViewer Grid.Row="2"
                                      Visibility="{Binding HasLogs, Converter={StaticResource BooleanToVisibilityConverter}}"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Style="{StaticResource SlimScrollViewerStyle}">
                        <ItemsControl ItemsSource="{Binding HistoryRows}">
                            <ItemsControl.Style>
                                <Style TargetType="ItemsControl">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLoadingLogs}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding HasLogs}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.Style>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#F8FAFC"
                                            BorderThickness="0,0,0,1"
                                            Padding="12,14">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="170" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="170" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="80" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding DateText}"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       FontSize="13.5"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center" />

                                            <Border Grid.Column="1"
                                                    HorizontalAlignment="Left"
                                                    Background="{StaticResource MintBgBrush}"
                                                    CornerRadius="8"
                                                    Padding="10,5"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding VolumeText}"
                                                           Foreground="{StaticResource MintTextBrush}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold" />
                                            </Border>

                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding RecommendationText}"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="13"
                                                       VerticalAlignment="Center" />

                                            <!-- evaluation, colored by kind -->
                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding EvaluationText}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,12,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding EvaluationKind}" Value="ok">
                                                                <Setter Property="Foreground" Value="#047857" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding EvaluationKind}" Value="warn">
                                                                <Setter Property="Foreground" Value="#B45309" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding EvaluationKind}" Value="skip">
                                                                <Setter Property="Foreground" Value="#1D4ED8" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <!-- notes, italic gray when empty -->
                                            <TextBlock Grid.Column="4"
                                                       Text="{Binding NotesText}"
                                                       FontSize="13"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,12,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding NotesEmpty}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                                                <Setter Property="FontStyle" Value="Italic" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <!-- actions, hidden on postponed-day rows -->
                                            <StackPanel Grid.Column="5"
                                                        Orientation="Horizontal"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding CanEdit, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Button Command="{Binding DataContext.OpenEditIrrigationModalCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding Log}"
                                                        ToolTip="Edit catatan penyiraman"
                                                        Width="30"
                                                        Height="30"
                                                        Margin="0,0,6,0"
                                                        Background="#F1F5F9"
                                                        BorderThickness="0"
                                                        Cursor="Hand">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="btnBdr"
                                                                    Background="{TemplateBinding Background}"
                                                                    CornerRadius="8">
                                                                <Path Data="{StaticResource PencilPath}"
                                                                      Fill="#475569"
                                                                      Width="13"
                                                                      Height="13"
                                                                      Stretch="Uniform"
                                                                      HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center" />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="btnBdr" Property="Background" Value="#E2E8F0" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>

                                                <Button Command="{Binding DataContext.OpenDeleteIrrigationModalCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding Log}"
                                                        ToolTip="Hapus catatan penyiraman"
                                                        Width="30"
                                                        Height="30"
                                                        Background="#FEF2F2"
                                                        BorderThickness="0"
                                                        Cursor="Hand">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="btnBdr"
                                                                    Background="{TemplateBinding Background}"
                                                                    CornerRadius="8">
                                                                <Path Data="{StaticResource TrashPath}"
                                                                      Fill="{StaticResource DangerRedBrush}"
                                                                      Width="13"
                                                                      Height="13"
                                                                      Stretch="Uniform"
                                                                      HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center" />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="btnBdr" Property="Background" Value="#FEE2E2" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
        </Grid>
    </Grid>
</UserControl>
