<UserControl x:Class="Lahanku.Views.Modals.MapPickerModalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             xmlns:helpers="clr-namespace:Lahanku.Helpers"
             mc:Ignorable="d" 
             d:DesignWidth="800" d:DesignHeight="680">

    <Border Background="{StaticResource CardBackgroundBrush}"
            CornerRadius="20"
            Padding="28"
            Width="760"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Effect="{StaticResource ModalShadow}">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Header -->
                <RowDefinition Height="Auto" /> <!-- Search Bar -->
                <RowDefinition Height="*" MinHeight="340" />    <!-- Map Canvas -->
                <RowDefinition Height="Auto" /> <!-- Selected Location Card -->
                <RowDefinition Height="Auto" /> <!-- Actions -->
            </Grid.RowDefinitions>

            <!-- Row 0: Header -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="PILIHAN TITIK GEOGRAFIS"
                               Foreground="{StaticResource AccentEmeraldBrush}"
                               FontSize="11"
                               FontWeight="Bold"
                               Margin="0,0,0,4" />
                    <TextBlock Text="Pilih Titik Lokasi Lahan"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="22"
                               FontWeight="Bold" />
                </StackPanel>

                <!-- Close Button (X) -->
                <Button Command="{Binding CancelCommand}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Width="32" Height="32">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border"
                                    Background="Transparent"
                                    CornerRadius="16">
                                <Path Data="{StaticResource ClosePath}"
                                      Fill="{StaticResource TextSecondaryBrush}"
                                      Stretch="Uniform"
                                      Width="12" Height="12"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#F1F5F9" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- Row 1: Search & Paste Google Maps Bar -->
            <Grid Grid.Row="1" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="110" />
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource RoundedTextBoxStyle}"
                         helpers:PlaceholderHelper.Placeholder="Ketik nama daerah/desa atau tempel tautan Google Maps..."
                         Height="44">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchLocationCommand}" />
                    </TextBox.InputBindings>
                </TextBox>

                <Button Grid.Column="2"
                        Content="Cari"
                        Command="{Binding SearchLocationCommand}"
                        Style="{StaticResource EmeraldButtonStyle}"
                        Height="44"
                        FontSize="13" />
            </Grid>

            <!-- Error Message if search fails -->
            <TextBlock Grid.Row="1"
                       Text="{Binding ErrorMessage}"
                       Foreground="{StaticResource DangerRedBrush}"
                       FontSize="12"
                       Margin="4,48,0,0"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource EmptyStringToVisibilityConverter}, ConverterParameter=Inverse}" />

            <!-- Row 2: Map Canvas -->
            <Border Grid.Row="2"
                    CornerRadius="14"
                    BorderThickness="1.2"
                    BorderBrush="{StaticResource InputBorderBrush}"
                    Background="#F1F5F9"
                    ClipToBounds="True"
                    Margin="0,0,0,16">
                <Grid>
                    <wv2:WebView2 x:Name="MapWebView" />

                    <!-- Loading Indicator Overlay -->
                    <Border x:Name="MapLoadingOverlay"
                            Background="#E2E8F0"
                            Visibility="Visible">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="Memuat Peta Interaktif..."
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="Menghubungkan ke OpenStreetMap &amp; Satelit"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="12"
                                       Margin="0,4,0,0"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Row 3: Detected Location Information Card -->
            <Border Grid.Row="3"
                    Background="{StaticResource MintBgBrush}"
                    BorderBrush="{StaticResource MintBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="14,12"
                    Margin="0,0,0,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Location Pin Icon -->
                    <Border Grid.Column="0"
                            Width="36" Height="36"
                            CornerRadius="18"
                            Background="#FFFFFF"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center">
                        <Path Data="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"
                              Fill="{StaticResource AccentEmeraldBrush}"
                              Width="18" Height="18"
                              Stretch="Uniform"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                    </Border>

                    <!-- Text details -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DetectedAddressText}"
                                   Foreground="{StaticResource PrimaryGreenDarkBrush}"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding CoordinatesDisplayText}"
                                   Foreground="{StaticResource MintTextBrush}"
                                   FontSize="11"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Row 4: Action Buttons -->
            <StackPanel Grid.Row="4"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="Batal"
                        Command="{Binding CancelCommand}"
                        Style="{StaticResource OutlineNeutralButtonStyle}"
                        Margin="0,0,12,0"
                        Width="100" />

                <Button Content="Gunakan Lokasi Ini"
                        Command="{Binding ConfirmLocationCommand}"
                        Style="{StaticResource EmeraldButtonStyle}"
                        Padding="20,0" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
