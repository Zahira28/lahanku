<UserControl x:Class="Lahanku.Views.Modals.LandModalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:helpers="clr-namespace:Lahanku.Helpers"
             mc:Ignorable="d" 
             d:DesignWidth="500">

    <Border Background="{StaticResource CardBackgroundBrush}"
            CornerRadius="20"
            Padding="32"
            Width="480"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Effect="{StaticResource ModalShadow}">

        <StackPanel>
            <!-- Subtitle -->
            <TextBlock Text="{Binding ModalSubtitle}"
                       Foreground="{StaticResource AccentEmeraldBrush}"
                       FontSize="11"
                       FontWeight="Bold"
                       Margin="0,0,0,6" />

            <!-- Title -->
            <TextBlock Text="{Binding ModalTitle}"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       FontSize="24"
                       FontWeight="Bold"
                       Margin="0,0,0,24" />

            <!-- Field: Nama Lahan -->
            <TextBlock Text="Nama Lahan"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8" />
            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource RoundedTextBoxStyle}"
                     helpers:PlaceholderHelper.Placeholder="Contoh: Sawah Sentosa Selatan"
                     Margin="0,0,0,18" />

            <!-- Field: Koordinat & Map Picker Trigger -->
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Koordinat"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />

                <!-- Button: Pilih Titik di Peta -->
                <Button Grid.Column="1"
                        Command="{Binding OpenMapPickerCommand}"
                        Cursor="Hand"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="btnBorder"
                                    Background="#ECFDF5"
                                    BorderBrush="{StaticResource AccentEmeraldLightBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="10,4">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"
                                          Fill="{StaticResource AccentEmeraldBrush}"
                                          Width="13" Height="13"
                                          Stretch="Uniform"
                                          Margin="0,0,6,0"
                                          VerticalAlignment="Center" />
                                    <TextBlock Text="Pilih Titik di Peta"
                                               Foreground="{StaticResource MintTextBrush}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="btnBorder" Property="Background" Value="#D1FAE5" />
                                    <Setter TargetName="btnBorder" Property="BorderBrush" Value="{StaticResource AccentEmeraldBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Latitude -->
                <TextBox Grid.Column="0"
                         Text="{Binding LatitudeText, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource RoundedTextBoxStyle}"
                         helpers:PlaceholderHelper.Placeholder="Contoh: -6.2088"
                         helpers:PlaceholderHelper.SuffixText="LAT" />

                <!-- Longitude -->
                <TextBox Grid.Column="2"
                         Text="{Binding LongitudeText, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource RoundedTextBoxStyle}"
                         helpers:PlaceholderHelper.Placeholder="Contoh: 106.8456"
                         helpers:PlaceholderHelper.SuffixText="LONG" />
            </Grid>

            <!-- Field: Luas Lahan -->
            <TextBlock Text="Luas Lahan"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8" />
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="145" />
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         Text="{Binding AreaValueText, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource RoundedTextBoxStyle}"
                         helpers:PlaceholderHelper.Placeholder="{Binding AreaPlaceholder}" />

                <ComboBox Grid.Column="2"
                          ItemsSource="{Binding AreaUnitOptions}"
                          SelectedItem="{Binding SelectedAreaUnit}"
                          Style="{StaticResource RoundedComboBoxStyle}" />
            </Grid>

            <!-- Field: Ditanami apa aja (Custom Searchable Animated Dropdown) -->
            <TextBlock Text="Ditanami apa aja"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8" />

            <Grid Margin="0,0,0,20">
                <!-- Dropdown Trigger Box -->
                <Border x:Name="CropTriggerBorder"
                        Background="{StaticResource InputBackgroundBrush}"
                        BorderThickness="1.2"
                        CornerRadius="12"
                        Height="46"
                        Padding="16,0"
                        Cursor="Hand">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCropDropdownOpen}" Value="True">
                                    <Setter Property="BorderBrush" Value="{StaticResource AccentEmeraldBrush}" />
                                    <Setter Property="BorderThickness" Value="1.5" />
                                </DataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                        <Condition Binding="{Binding IsCropDropdownOpen}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="BorderBrush" Value="#CBD5E1" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{Binding ToggleCropDropdownCommand}" />
                    </Border.InputBindings>

                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Leaf Icon -->
                        <Path Grid.Column="0"
                              Data="{StaticResource LeafPath}"
                              Fill="{StaticResource AccentEmeraldBrush}"
                              Width="15"
                              Height="15"
                              Stretch="Uniform"
                              Margin="0,0,10,0"
                              VerticalAlignment="Center" />

                        <!-- Selected Crop Display Text -->
                        <Grid Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Pilih atau cari tanaman..."
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="14"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding SelectedCropType, Converter={StaticResource EmptyStringToVisibilityConverter}}" />
                            <TextBlock Text="{Binding SelectedCropType}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="14"
                                       FontWeight="Medium"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding SelectedCropType, Converter={StaticResource EmptyStringToVisibilityConverter}, ConverterParameter=Inverse}" />
                        </Grid>

                        <!-- Animated Rotating Chevron -->
                        <Path x:Name="ChevronArrow"
                              Grid.Column="2"
                              Data="{StaticResource ChevronDownPath}"
                              Fill="{StaticResource AccentEmeraldBrush}"
                              Width="14"
                              Height="14"
                              Stretch="Uniform"
                              VerticalAlignment="Center"
                              RenderTransformOrigin="0.5,0.5">
                            <Path.RenderTransform>
                                <RotateTransform x:Name="ChevronRotate" Angle="0" />
                            </Path.RenderTransform>
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCropDropdownOpen}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                         To="180"
                                                                         Duration="0:0:0.25">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseInOut" />
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                         To="0"
                                                                         Duration="0:0:0.25">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseInOut" />
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Grid>
                </Border>

                <!-- Searchable Popup -->
                <Popup x:Name="CropPopup"
                       PlacementTarget="{Binding ElementName=CropTriggerBorder}"
                       Placement="Bottom"
                       VerticalOffset="6"
                       IsOpen="{Binding IsCropDropdownOpen, Mode=TwoWay}"
                       StaysOpen="True"
                       AllowsTransparency="True"
                       PopupAnimation="Fade"
                       Opened="CropPopup_Opened">
                    <Border x:Name="CropPopupContent"
                            Width="{Binding ActualWidth, ElementName=CropTriggerBorder}"
                            Background="#FFFFFF"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="12"
                            Margin="0,0,0,10">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="22"
                                              ShadowDepth="6"
                                              Direction="270"
                                              Opacity="0.12"
                                              Color="#0F172A" />
                        </Border.Effect>

                        <StackPanel>
                            <!-- Search Bar -->
                            <Border Background="#F8FAFC"
                                    BorderBrush="#E2E8F0"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Height="40"
                                    Padding="10,0"
                                    Margin="0,0,0,8">
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Search Icon -->
                                    <Path Grid.Column="0"
                                          Data="{StaticResource SearchPath}"
                                          Fill="#94A3B8"
                                          Width="14"
                                          Height="14"
                                          Stretch="Uniform"
                                          Margin="0,0,8,0"
                                          VerticalAlignment="Center" />

                                    <!-- Search Input -->
                                    <Grid Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Cari varietas tanaman..."
                                                   Foreground="#94A3B8"
                                                   FontSize="13"
                                                   VerticalAlignment="Center"
                                                   IsHitTestVisible="False"
                                                   Visibility="{Binding CropSearchQuery, Converter={StaticResource EmptyStringToVisibilityConverter}}" />
                                        <TextBox x:Name="CropSearchTextBox"
                                                 Text="{Binding CropSearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="13"
                                                 Foreground="{StaticResource TextPrimaryBrush}"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 VerticalAlignment="Center"
                                                 KeyDown="CropSearchTextBox_KeyDown" />
                                    </Grid>

                                    <!-- Clear Search Button -->
                                    <Button Grid.Column="2"
                                            Command="{Binding ClearCropSearchCommand}"
                                            Cursor="Hand"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="4"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding CropSearchQuery, Converter={StaticResource EmptyStringToVisibilityConverter}, ConverterParameter=Inverse}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="Transparent">
                                                    <Path Data="{StaticResource ClosePath}"
                                                          Fill="#94A3B8"
                                                          Width="11"
                                                          Height="11"
                                                          Stretch="Uniform" />
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Results Counter -->
                            <TextBlock Text="{Binding FilteredCropCountText}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="11"
                                       FontWeight="Medium"
                                       Margin="4,0,0,6" />

                            <!-- Divider -->
                            <Separator Background="#F1F5F9" Margin="0,0,0,6" />

                            <!-- Empty State -->
                            <StackPanel Margin="0,16"
                                        HorizontalAlignment="Center"
                                        Visibility="{Binding HasNoFilteredCrops, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Path Data="{StaticResource AlertCirclePath}"
                                      Fill="#94A3B8"
                                      Width="24"
                                      Height="24"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center"
                                      Margin="0,0,0,6" />
                                <TextBlock Text="Tanaman tidak ditemukan"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="Coba kata kunci lain"
                                           Foreground="#94A3B8"
                                           FontSize="11"
                                           HorizontalAlignment="Center"
                                           Margin="0,2,0,0" />
                            </StackPanel>

                            <!-- Filtered Crop List -->
                            <ScrollViewer MaxHeight="200"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          SnapsToDevicePixels="True"
                                          Style="{StaticResource SlimScrollViewerStyle}"
                                          Visibility="{Binding HasNoFilteredCrops, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
                                <ItemsControl ItemsSource="{Binding FilteredCropOptions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.SelectCropCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource CropListItemButtonStyle}"
                                                    Margin="0,1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding}"
                                                               FontSize="13"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" />

                                                    <!-- Selected Checkmark -->
                                                    <Path Grid.Column="1"
                                                          Data="{StaticResource CheckPath}"
                                                          Fill="{StaticResource AccentEmeraldBrush}"
                                                          Width="14"
                                                          Height="14"
                                                          Stretch="Uniform"
                                                          VerticalAlignment="Center"
                                                          Margin="8,0,4,0">
                                                        <Path.Visibility>
                                                            <MultiBinding Converter="{StaticResource EqualityToVisibilityConverter}">
                                                                <Binding />
                                                                <Binding Path="DataContext.SelectedCropType" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                            </MultiBinding>
                                                        </Path.Visibility>
                                                    </Path>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>

            <!-- Error Message -->
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{StaticResource DangerRedBrush}"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Margin="0,0,0,16"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource EmptyStringToVisibilityConverter}, ConverterParameter=Inverse}" />

            <!-- Buttons: Batal & Simpan -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,8,0,0">
                <Button Content="Batal"
                        Command="{Binding CancelCommand}"
                        Style="{StaticResource OutlineNeutralButtonStyle}"
                        Margin="0,0,12,0" />

                <Button Content="{Binding SubmitButtonText}"
                        Command="{Binding SaveCommand}"
                        Style="{StaticResource EmeraldButtonStyle}" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
