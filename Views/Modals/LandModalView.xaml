<UserControl x:Class="Lahanku.Views.Modals.LandModalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:helpers="clr-namespace:Lahanku.Helpers"
             mc:Ignorable="d" 
             d:DesignWidth="500">

    <Border Background="{StaticResource CardBackgroundBrush}"
            CornerRadius="20"
            Padding="32"
            Width="480"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Effect="{StaticResource ModalShadow}">

        <StackPanel>
            <!-- Subtitle -->
            <TextBlock Text="{Binding ModalSubtitle}"
                       Foreground="{StaticResource AccentEmeraldBrush}"
                       FontSize="11"
                       FontWeight="Bold"
                       Margin="0,0,0,6" />

            <!-- Title -->
            <TextBlock Text="{Binding ModalTitle}"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       FontSize="24"
                       FontWeight="Bold"
                       Margin="0,0,0,24" />

            <!-- Field: Nama Lahan -->
            <TextBlock Text="Nama Lahan"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8" />
            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource RoundedTextBoxStyle}"
                     helpers:PlaceholderHelper.Placeholder="Contoh: Sawah Sentosa Selatan"
                     Margin="0,0,0,18" />

            <!-- Field: Koordinat -->
            <TextBlock Text="Koordinat"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8" />
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Latitude -->
                <TextBox Grid.Column="0"
                         Text="{Binding LatitudeText, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource RoundedTextBoxStyle}"
                         helpers:PlaceholderHelper.SuffixText="LAT" />

                <!-- Longitude -->
                <TextBox Grid.Column="2"
                         Text="{Binding LongitudeText, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource RoundedTextBoxStyle}"
                         helpers:PlaceholderHelper.SuffixText="LONG" />
            </Grid>

            <!-- Field: Luas (Hektar) -->
            <TextBlock Text="Luas (Hektar)"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8" />
            <TextBox Text="{Binding AreaHectaresText, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource RoundedTextBoxStyle}"
                     helpers:PlaceholderHelper.SuffixText="Ha"
                     Margin="0,0,0,18" />

            <!-- Field: Ditanami apa aja -->
            <TextBlock Text="Ditanami apa aja"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8" />
            <ComboBox ItemsSource="{Binding CropOptions}"
                      SelectedItem="{Binding SelectedCropType}"
                      Style="{StaticResource RoundedComboBoxStyle}"
                      Margin="0,0,0,20" />

            <!-- Error Message -->
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{StaticResource DangerRedBrush}"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Margin="0,0,0,16"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource EmptyStringToVisibilityConverter}, ConverterParameter=Inverse}" />

            <!-- Buttons: Batal & Simpan -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,8,0,0">
                <Button Content="Batal"
                        Command="{Binding CancelCommand}"
                        Style="{StaticResource OutlineNeutralButtonStyle}"
                        Margin="0,0,12,0" />

                <Button Content="{Binding SubmitButtonText}"
                        Command="{Binding SaveAsyncCommand}"
                        Style="{StaticResource EmeraldButtonStyle}" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
