<UserControl x:Class="Lahanku.Views.Modals.IrrigationModalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:helpers="clr-namespace:Lahanku.Helpers"
             mc:Ignorable="d" 
             d:DesignWidth="500">

    <Border Background="{StaticResource CardBackgroundBrush}"
            CornerRadius="20"
            Padding="32"
            Width="480"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Effect="{StaticResource ModalShadow}">

        <StackPanel>
            <!-- Subtitle -->
            <TextBlock Text="LOG IRIGASI &amp; PENYIRAMAN"
                       Foreground="{StaticResource AccentEmeraldBrush}"
                       FontSize="11"
                       FontWeight="Bold"
                       Margin="0,0,0,6" />

            <!-- Title -->
            <TextBlock Text="{Binding ModalTitle}"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       FontSize="24"
                       FontWeight="Bold"
                       Margin="0,0,0,24" />

            <!-- Field: Tanggal Penyiraman -->
            <TextBlock Text="Tanggal Penyiraman"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8" />
            <Border Background="{StaticResource InputBackgroundBrush}"
                    BorderBrush="{StaticResource InputBorderBrush}"
                    BorderThickness="1.2"
                    CornerRadius="12"
                    Height="46"
                    Padding="16,0"
                    Margin="0,0,0,18">
                <Grid VerticalAlignment="Center">
                    <DatePicker SelectedDate="{Binding Date, Mode=TwoWay}"
                                BorderThickness="0"
                                Background="Transparent"
                                VerticalAlignment="Center"
                                FontSize="14" />
                </Grid>
            </Border>

            <!-- Field: Volume Air -->
            <TextBlock Text="Volume Air"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8" />
            <TextBox Text="{Binding VolumeLitersText, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource RoundedTextBoxStyle}"
                     helpers:PlaceholderHelper.SuffixText="LITER"
                     Margin="0,0,0,18" />

            <!-- Field: Catatan -->
            <TextBlock Text="Catatan"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8" />
            <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource RoundedMultilineTextBoxStyle}"
                     helpers:PlaceholderHelper.Placeholder="Contoh: Kondisi tanah agak kering di lereng barat."
                     Margin="0,0,0,20" />

            <!-- Error Message -->
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{StaticResource DangerRedBrush}"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Margin="0,0,0,16"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource EmptyStringToVisibilityConverter}, ConverterParameter=Inverse}" />

            <!-- Buttons: Batal & Simpan -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,8,0,0">
                <Button Content="Batal"
                        Command="{Binding CancelCommand}"
                        Style="{StaticResource OutlineNeutralButtonStyle}"
                        Margin="0,0,12,0" />

                <Button Content="Simpan"
                        Command="{Binding SaveAsyncCommand}"
                        Style="{StaticResource EmeraldButtonStyle}" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
