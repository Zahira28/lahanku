<UserControl x:Class="Lahanku.Views.ImpactView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:Lahanku.Controls"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1100">
    <UserControl.Resources>
        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="18,16" />
        </Style>
        <Style x:Key="TileLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="TileValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
        </Style>
        <Style x:Key="TileUnit" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Margin" Value="4,0,0,4" />
        </Style>
        <Style x:Key="TileNote" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="HeadCell" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="10,8" />
        </Style>
        <Style x:Key="Cell" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Padding" Value="10,9" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SegButton" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="12,5">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"
                                              TextElement.FontWeight="{TemplateBinding FontWeight}"
                                              TextElement.FontSize="12" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F8FAFC" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#ECFDF5" />
                    <Setter Property="Foreground" Value="#047857" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource PageBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <controls:Sidebar Grid.Column="0" ActiveItem="Dampak" />

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="40,32">
                <!-- header + period switch -->
                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Dampak Penghematan Air" Foreground="{StaticResource TextPrimaryBrush}" FontSize="28" FontWeight="Bold" />
                        <TextBlock Text="Dibandingkan penyiraman rutin dengan takaran standar setiap hari."
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="3" HorizontalAlignment="Right">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="7 hari" GroupName="period" Style="{StaticResource SegButton}" ToolTip="7 hari terakhir (1)"
                                             IsChecked="{Binding IsPeriod7, Mode=OneWay}" Command="{Binding SelectPeriodCommand}" CommandParameter="7" />
                                <RadioButton Content="30 hari" GroupName="period" Style="{StaticResource SegButton}" ToolTip="30 hari terakhir (2)" Margin="2,0"
                                             IsChecked="{Binding IsPeriod30, Mode=OneWay}" Command="{Binding SelectPeriodCommand}" CommandParameter="30" />
                                <RadioButton Content="Semua" GroupName="period" Style="{StaticResource SegButton}" ToolTip="Seluruh catatan (3)"
                                             IsChecked="{Binding IsPeriodAll, Mode=OneWay}" Command="{Binding SelectPeriodCommand}" CommandParameter="semua" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding RangeText}" Foreground="{StaticResource TextMutedBrush}" FontSize="11.5"
                                   HorizontalAlignment="Right" Margin="0,6,2,0" />
                    </StackPanel>
                </Grid>

                <!-- loading skeleton -->
                <StackPanel Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.3*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource Panel}" Margin="0,0,6,0" Height="118">
                            <StackPanel>
                                <Border Style="{StaticResource SkeletonBoxStyle}" Width="110" Height="12" CornerRadius="4" HorizontalAlignment="Left" Margin="0,0,0,14" />
                                <Border Style="{StaticResource SkeletonBoxStyle}" Width="130" Height="26" CornerRadius="6" HorizontalAlignment="Left" Margin="0,0,0,12" />
                                <Border Style="{StaticResource SkeletonBoxStyle}" Width="190" Height="10" CornerRadius="4" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource Panel}" Margin="6,0" Height="118">
                            <StackPanel>
                                <Border Style="{StaticResource SkeletonBoxStyle}" Width="100" Height="12" CornerRadius="4" HorizontalAlignment="Left" Margin="0,0,0,14" />
                                <Border Style="{StaticResource SkeletonBoxStyle}" Width="70" Height="22" CornerRadius="6" HorizontalAlignment="Left" Margin="0,0,0,14" />
                                <Border Style="{StaticResource SkeletonBoxStyle}" Width="110" Height="10" CornerRadius="4" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource Panel}" Margin="6,0" Height="118">
                            <StackPanel>
                                <Border Style="{StaticResource SkeletonBoxStyle}" Width="100" Height="12" CornerRadius="4" HorizontalAlignment="Left" Margin="0,0,0,14" />
                                <Border Style="{StaticResource SkeletonBoxStyle}" Width="70" Height="22" CornerRadius="6" HorizontalAlignment="Left" Margin="0,0,0,14" />
                                <Border Style="{StaticResource SkeletonBoxStyle}" Width="110" Height="10" CornerRadius="4" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="3" Style="{StaticResource Panel}" Margin="6,0,0,0" Height="118">
                            <StackPanel>
                                <Border Style="{StaticResource SkeletonBoxStyle}" Width="100" Height="12" CornerRadius="4" HorizontalAlignment="Left" Margin="0,0,0,14" />
                                <Border Style="{StaticResource SkeletonBoxStyle}" Width="70" Height="22" CornerRadius="6" HorizontalAlignment="Left" Margin="0,0,0,14" />
                                <Border Style="{StaticResource SkeletonBoxStyle}" Width="110" Height="10" CornerRadius="4" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Border Style="{StaticResource Panel}">
                        <StackPanel>
                            <Border Style="{StaticResource SkeletonBoxStyle}" Width="150" Height="12" CornerRadius="4" HorizontalAlignment="Left" Margin="0,0,0,16" />
                            <Border Style="{StaticResource SkeletonBoxStyle}" Height="220" CornerRadius="8" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- no records yet -->
                <Border Style="{StaticResource Panel}" Padding="28,32"
                        Visibility="{Binding ShowEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="52" Height="52" CornerRadius="14" Background="#ECFDF5" HorizontalAlignment="Center" Margin="0,0,0,14">
                            <Path Data="{StaticResource ChartLinePath}" Fill="{StaticResource AccentEmeraldBrush}" Width="24" Height="24" Stretch="Uniform" />
                        </Border>
                        <TextBlock Text="Belum ada data untuk periode ini" Foreground="{StaticResource TextPrimaryBrush}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="Buka LahanKu setiap hari dan catat penyiraman agar penghematan air dapat dihitung."
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="0,6,0,0"
                                   TextWrapping="Wrap" TextAlignment="Center" MaxWidth="420" />
                    </StackPanel>
                </Border>

                <!-- real content -->
                <StackPanel Visibility="{Binding ShowContent, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <!-- 4 tiles; Grid keeps them the same height -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.3*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource Panel}" Margin="0,0,6,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Air yang dihemat" Style="{StaticResource TileLabel}" />
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,10" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding SavedText}" Style="{StaticResource TileValue}" FontSize="30" />
                                    <TextBlock Text="L" Style="{StaticResource TileUnit}" Margin="5,0,0,6" />
                                </StackPanel>
                                <TextBlock Grid.Row="2" Text="{Binding SavedNote}" Style="{StaticResource TileNote}" />
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource Panel}" Margin="6,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Ditunda karena hujan" Style="{StaticResource TileLabel}" />
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,10" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding PostponedDaysText}" Style="{StaticResource TileValue}" />
                                    <TextBlock Text="hari" Style="{StaticResource TileUnit}" />
                                </StackPanel>
                                <TextBlock Grid.Row="2" Text="{Binding PostponedNote}" Style="{StaticResource TileNote}" />
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource Panel}" Margin="6,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Penyesuaian takaran" Style="{StaticResource TileLabel}" />
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,10" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding AdjustmentText}" Style="{StaticResource TileValue}" />
                                    <TextBlock Text="L" Style="{StaticResource TileUnit}" />
                                </StackPanel>
                                <TextBlock Grid.Row="2" Text="{Binding AdjustmentNote}" Style="{StaticResource TileNote}" />
                            </Grid>
                        </Border>

                        <Border Grid.Column="3" Style="{StaticResource Panel}" Margin="6,0,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Sesuai rekomendasi" Style="{StaticResource TileLabel}" />
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,10" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding OnTargetText}" Style="{StaticResource TileValue}" />
                                    <TextBlock Text="%" Style="{StaticResource TileUnit}" />
                                </StackPanel>
                                <TextBlock Grid.Row="2" Text="{Binding OnTargetNote}" Style="{StaticResource TileNote}" />
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- daily chart -->
                    <Border Style="{StaticResource Panel}" Margin="0,0,0,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="Pemakaian air harian" Foreground="{StaticResource TextPrimaryBrush}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Rectangle Width="16" Height="2.5" Fill="#059669" RadiusX="1" RadiusY="1" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="Dipakai" Foreground="#475569" FontSize="12" Margin="0,0,16,0" />
                                    <Line X1="0" X2="16" Y1="1" Y2="1" Stroke="#64748B" StrokeThickness="1.5" StrokeDashArray="3,2" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="Penyiraman rutin" Foreground="#475569" FontSize="12" Margin="0,0,16,0" />
                                    <Ellipse Width="9" Height="9" Fill="#3B82F6" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="Ditunda karena hujan" Foreground="#475569" FontSize="12" />
                                </StackPanel>
                            </Grid>
                            <controls:WaterLineChart Height="240" Points="{Binding Daily}" ReferenceValue="{Binding ReferenceValue}" />
                        </StackPanel>
                    </Border>

                    <!-- per land -->
                    <Border Style="{StaticResource Panel}" Padding="8,12">
                        <StackPanel>
                            <TextBlock Text="Per lahan" Foreground="{StaticResource TextPrimaryBrush}" FontSize="14" FontWeight="SemiBold" Margin="10,0,0,6" />
                            <Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Lahan" Style="{StaticResource HeadCell}" />
                                    <TextBlock Grid.Column="1" Text="Penyiraman rutin" Style="{StaticResource HeadCell}" TextAlignment="Right" />
                                    <TextBlock Grid.Column="2" Text="Dipakai" Style="{StaticResource HeadCell}" TextAlignment="Right" />
                                    <TextBlock Grid.Column="3" Text="Dihemat" Style="{StaticResource HeadCell}" TextAlignment="Right" />
                                    <TextBlock Grid.Column="4" Text="Sesuai rekomendasi" Style="{StaticResource HeadCell}" TextAlignment="Right" />
                                </Grid>
                            </Border>
                            <ItemsControl ItemsSource="{Binding LandRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Cell}" FontWeight="SemiBold" Padding="10,9,6,9" />
                                                    <TextBlock Text="{Binding AreaText}" Foreground="{StaticResource TextMutedBrush}" FontSize="11.5" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding BaselineText}" Style="{StaticResource Cell}" TextAlignment="Right" />
                                                <TextBlock Grid.Column="2" Text="{Binding UsedText}" Style="{StaticResource Cell}" TextAlignment="Right" />
                                                <TextBlock Grid.Column="3" Text="{Binding SavedText}" TextAlignment="Right">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Cell}">
                                                            <Setter Property="Foreground" Value="#047857" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsOver}" Value="True">
                                                                    <Setter Property="Foreground" Value="#B45309" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Grid.Column="4" Text="{Binding OnTargetText}" Style="{StaticResource Cell}" TextAlignment="Right" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Hari tanpa catatan rekomendasi (aplikasi tidak dibuka) tidak ikut dihitung."
                               Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="2,12,0,0" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
