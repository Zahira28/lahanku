<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>Lahanku</RootNamespace>
    <AssemblyName>Lahanku</AssemblyName>
  </PropertyGroup>

  <!-- dotnet publish -c Release -r win-x64 → one Lahanku.exe that runs without installing .NET -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
    <PackageReference Include="Supabase" Version="8.1.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <!-- the published .exe carries its own copy (below), so nothing else to ship -->
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </None>
    <!-- baked into the .exe; a real appsettings.json next to the .exe still wins -->
    <EmbeddedResource Include="appsettings.json" Condition="Exists('appsettings.json')" LogicalName="Lahanku.appsettings.json" />
  </ItemGroup>

  <!-- folder tes punya project sendiri -->
  <ItemGroup>
    <Compile Remove="Lahanku.Tests/**" />
    <None Remove="Lahanku.Tests/**" />
    <Page Remove="Lahanku.Tests/**" />
  </ItemGroup>

</Project>
